+void copyText(const std::string &text, char *buffer, int length) {
+    if (buffer == nullptr || length <= 0) {
+        return;
+    }
+    std::strncpy(buffer, text.c_str(), (size_t)length - 1);
+    buffer[length - 1] = '\0';
+}
