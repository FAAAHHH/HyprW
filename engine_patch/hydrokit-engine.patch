+        vfieldgrid = _vfield->getArray3dU();
+        validgrid = &(_validVelocities->validU);
+        component = 0;
+    } else if (dir == Direction::V) {
+        vfieldgrid = _vfield->getArray3dV();
+        validgrid = &(_validVelocities->validV);
+        component = 1;
+    } else {
+        vfieldgrid = _vfield->getArray3dW();
+        validgrid = &(_validVelocities->validW);
+        component = 2;
+    }
+
+    BlockArray3dParameters blockParams;
+    blockParams.isize = vfieldgrid->width;
+    blockParams.jsize = vfieldgrid->height;
+    blockParams.ksize = vfieldgrid->depth;
+    blockParams.blockwidth = _chunkWidth;
+    Dims3d blockDims = BlockArray3d<ScalarData>::getBlockDimensions(blockParams);
+    std::vector<unsigned char> blockActive((size_t)blockDims.i * blockDims.j * blockDims.k, 0);
+    for (int k = 0; k < blockDims.k; k++) {
+        for (int j = 0; j < blockDims.j; j++) {
+            for (int i = 0; i < blockDims.i; i++) {
+                if (blockphi.getBlockID(i, j, k) >= 0) {
+                    blockActive[(size_t)i + (size_t)blockDims.i * ((size_t)j + (size_t)blockDims.j * (size_t)k)] = 1;
+                }
+            }
+        }
+    }
+
+    // The values _computeGridCountDataThread and _advectionFLIPProducerThread use
+    float eps = 1e-6;
