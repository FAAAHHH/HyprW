+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+SOFTWARE.
+*/
+
+#ifndef FLUIDENGINE_HKGPU_H
+#define FLUIDENGINE_HKGPU_H
+
+/*
+    HydroKit GPU support (NVIDIA, CUDA driver API).
+
+    The CUDA driver is opened at run time: the engine builds without the CUDA
+    toolkit and runs without an NVIDIA driver. Every GPU step reports failure
+    instead of throwing, and its caller then computes on the CPU — a missing
+    driver, too little GPU memory or a driver error never stops a bake.
+
+    The kernels are in hkgpu_kernels.cu (embedded as hkgpu_kernels_fatbin.h).
+*/
+
+#include <string>
+#include <vector>
+
+namespace HKGPU {
+
+// ParticleMesher's scalar field for one compute chunk — see
+// hk_mesher_scalar_field in hkgpu_kernels.cu for the meaning of each value.
+struct MesherFieldInput {
+    const float *particles = nullptr;           // x y z per particle, chunk-local
+    int numParticles = 0;
+    const unsigned char *blockActive = nullptr; // 1 per active block
+    int nbi = 0, nbj = 0, nbk = 0;              // block grid size
+    int isize = 0, jsize = 0, ksize = 0;        // node grid size of the chunk
+    int blockwidth = 10;
+    double subdx = 0.0;
+    float blockdxFloat = 0.0f;                  // float blockdx = _blockwidth * _subdx
+    double blockdxDouble = 0.0;                 // _blockwidth * _subdx
+    float radius = 0.0f;
+    float searchRadius = 0.0f;
+    float maxDistance = 0.0f;                   // starting value of every node
+    // ParticleLevelSet: cell centres (+ dx/2) and a box without the + 1
+    double halfOffset = 0.0;
+    int boxPlusOne = 1;
+};
+
+// A CUDA driver and a usable device (compute capability 7.5 or newer). Probed
+// once, without creating a context, so it costs no GPU memory.
+bool isAvailable();
+std::string getDeviceName();
+size_t getDeviceMemory();
+
+// Why the GPU is unavailable, or the last error that sent a step to the CPU
+std::string getStatusMessage();
+
+// Field values before ParticleMesher's negation, index i + isize*(j + jsize*k).
+// False: not computed, use the CPU. step: STEP_MESH or STEP_WATER for the
+// counters (the liquid level set uses the same kernel).
+// With preview: also the lighter viewport mesh's field at every preview node
+// (ParticleMesher::_addComputeChunkScalarFieldToPreviewField), sampled while
+// the chunk's field is still on the GPU. previewSet is 1 where the CPU would
+// write a value; both stay empty when the GPU could not do it.
+struct MesherPreviewInput {
+    int pisize = 0, pjsize = 0, pksize = 0;          // preview node grid size
+    double pdx = 0.0;
+    float offset[3] = {0.0f, 0.0f, 0.0f};             // chunk position
+    double width = 0.0, height = 0.0, depth = 0.0;    // chunk box as the CPU builds it
+    double eps = 0.0;
+};
+bool computeMesherScalarField(const MesherFieldInput &in, std::vector<float> &out, int step = 0,
+                              const MesherPreviewInput *preview = nullptr,
+                              std::vector<float> *previewValues = nullptr,
+                              std::vector<unsigned char> *previewSet = nullptr);
+
+// Polygonizer3d::polygonizeSurface (marching cubes) — see hk_mc_* in
+// hkgpu_kernels.cu. The same vertices (x y z) and triangles (3 indices) in
+// the same order as the CPU. False: not computed, use the CPU.
+struct PolygonizeInput {
+    const float *values = nullptr;              // node values, i + ni * (j + nj * k)
+    const unsigned char *solidVertex = nullptr; // ScalarField's solid nodes, same index
+    int ni = 0, nj = 0, nk = 0;                 // node grid size (cells: one less)
+    double dx = 0.0;
+    double threshold = 0.0;
+    bool hasSolidSDF = false;                   // Polygonizer3d with a MeshLevelSet
+    const float *solidPhi = nullptr;            // its phi, i + si * (j + sj * k)
+    int si = 0, sj = 0, sk = 0;
+    double solidDx = 0.0;
+    float offset[3] = {0.0f, 0.0f, 0.0f};        // ScalarField::getOffset()
+};
+bool polygonizeSurface(const PolygonizeInput &in, std::vector<float> &vertices,
+                       std::vector<int> &triangles, int step = 0);
+
+// TriangleMesh::smooth — see hk_smooth_* in hkgpu_kernels.cu. The vertices
+// (x y z) are smoothed in place, the same positions as the CPU. False: not
+// computed, use the CPU.
+bool smoothMesh(float *vertices, int numVertices, const int *triangles, int numTriangles,
+                double value, int iterations, int step = 0);
+
+// LevelSetSolver::reinitializeUpwind — see hk_reinit_upwind_step
+struct ReinitInput {
+    const float *inputSDF = nullptr;            // isize x jsize x ksize
+    int isize = 0, jsize = 0, ksize = 0;
+    const std::vector<int> *cells = nullptr;    // solver cells as flat indices
+    float dx = 0.0f;
+    float dtau = 0.0f;
+    int numIterations = 0;
+    float errorThreshold = 0.0f;                // _upwindErrorThreshold * dx
+};
+
+// The whole reinitialized grid into output (isize*jsize*ksize floats).
+// False: not computed, use the CPU.
+bool reinitializeUpwind(const ReinitInput &in, float *output);
+
+// VelocityAdvector FLIP transfer for one velocity component — see hk_p2g_scatter
+struct P2GInput {
+    const float *points = nullptr;          // x y z per particle
+    const float *velocities = nullptr;      // x y z per particle
+    int component = 0;                      // 0 u, 1 v, 2 w
+    int numParticles = 0;
+    float offset[3] = {0.0f, 0.0f, 0.0f};   // _getDirectionOffset
+    const unsigned char *blockActive = nullptr;
+    int nbi = 0, nbj = 0, nbk = 0;
+    int isize = 0, jsize = 0, ksize = 0;    // face grid of the component
+    int blockwidth = 10;
+    double dx = 0.0;
+    float blockdxFloat = 0.0f;              // float blockdx = _chunkdx
+    double blockdxDouble = 0.0;             // _chunkWidth * _dx
+    float radius = 0.0f;                    // float r = _particleRadius
+    float searchRadius = 0.0f;              // _particleRadius + eps
+    float eps = 1e-6f;
+};
+
+// Face values and valid flags (isize*jsize*ksize each). False: use the CPU.
+bool particleToGrid(const P2GInput &in, float *field, unsigned char *valid);
+
+// PCGSolver::solve with its MIC(0) factor already formed on the CPU — see
+// hk_pcg_* in hkgpu_kernels.cu
+struct PCGInput {
+    int n = 0;
+    // the matrix (FixedSparseMatrix)
+    const unsigned int *rowstart = nullptr;     // n + 1
+    const unsigned int *colindex = nullptr;
+    const double *value = nullptr;
+    // the factor (SparseColumnLowerFactor, column by column)
+    const double *invdiag = nullptr;            // n
+    const unsigned int *colstart = nullptr;     // n + 1
+    const unsigned int *rowindex = nullptr;
+    const double *factorValue = nullptr;
+    const double *rhs = nullptr;
+    double toleranceFactor = 0.0;
+    double maxErrorTolerance = 1.0;
+    int maxIterations = 0;
+};
+
+struct PCGResult {
+    bool converged = false;
+    double residual = 0.0;
+    int iterations = 0;
+};
+
+// result: initial guess in, solution out (n). False: not computed, use the CPU.
+bool solvePCG(const PCGInput &in, double *result, PCGResult &out);
+
+// The GPU steps, for counting and verification
+enum Step {
+    STEP_MESH = 0,          // surface mesher scalar field
+    STEP_CURVATURE = 1,     // surface curvature: level set reinitialization
+    STEP_WATER = 2,         // liquid level set from the marker particles
+    STEP_ADVECTION = 3,     // particle velocities to the grid (FLIP transfer)
+    STEP_PRESSURE = 4,      // pressure solve (PCG)
+    NUM_STEPS = 5
+};
+
+// Free the GPU buffers and the context, e.g. after a bake — so the memory is
+// back for Blender's viewport and Cycles.
+void release();
+
+// How many calls of a step ran on the GPU and how many fell back to the CPU
+void resetCounters();
+int getGPUCount(int step);
+int getFallbackCount(int step);
+
+// Verification for tests: compute each GPU result on the CPU as well and
+// count the values that differ in any bit.
+void setVerifyEnabled(bool enabled);
+bool isVerifyEnabled();
+void addVerifyResult(int step, long long mismatches, long long compared);
+long long getVerifyMismatches(int step);
+long long getVerifyCompared(int step);
+// Steps that agree to float rounding only: the largest difference seen
+void addVerifyMaxDiff(int step, double difference);
+double getVerifyMaxDiff(int step);
+
+// Verification also times both ways of every call, for choosing the faster
+// device per step (seconds, summed since resetCounters)
+void addVerifyTiming(int step, double gpuSeconds, double cpuSeconds);
+double getVerifyGPUTime(int step);
+double getVerifyCPUTime(int step);
+
+}
+
+#endif
