+std::vector<int> FluidSimulation::getAdaptiveParticleLevelCounts() {
+    std::vector<int> counts(_adaptiveParticleMaxLevelLimit + 1, 0);
+    if (_markerParticles.getAttribute(_adaptiveParticleLevelName).id < 0) {
+        counts[0] = (int)_markerParticles.size();
+        return counts;
+    }
+
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+    for (size_t i = 0; i < levels->size(); i++) {
+        int level = std::min((int)levels->at(i), _adaptiveParticleMaxLevelLimit);
+        counts[level]++;
+    }
+    return counts;
+}
+
+bool FluidSimulation::hasMarkerParticleLevelData() {
+    return _markerParticles.getAttribute(_adaptiveParticleLevelName).id >= 0;
+}
+
+void FluidSimulation::getMarkerParticleLevelDataRange(size_t start_idx, size_t end_idx, char *data) {
+    if (end_idx > _markerParticles.size() || start_idx > end_idx) {
+        std::string msg = "Error: invalid range.\n";
+        msg += "range: [" + _toString(start_idx) + ", " + _toString(end_idx) + "]\n";
+        throw std::domain_error(msg);
+    }
+    if (!hasMarkerParticleLevelData()) {
+        std::fill(data, data + (end_idx - start_idx), (char)0);
+        return;
+    }
+
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+    for (size_t i = start_idx; i < end_idx; i++) {
+        data[i - start_idx] = (char)levels->at(i);
+    }
+}
+
+void FluidSimulation::loadMarkerParticleLevelData(size_t size, char *levels) {
+    // In the order of the loaded particles, taken by _loadMarkerParticles
+    // together with each particle, so one dropped there cannot shift the rest
+    unsigned char *values = (unsigned char*)levels;
+    _adaptiveLevelLoadData.insert(_adaptiveLevelLoadData.end(), values, values + size);
+}
