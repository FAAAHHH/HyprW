@@ -0,0 +1,37 @@
+#!/bin/sh
+# MIT License — Copyright (C) 2026 FAAAHHH (HyprW)
+#
+# Rebuilds hkgpu_kernels_fatbin.h from hkgpu_kernels.cu. Only needed after
+# changing the kernels: the generated header is part of the sources, so
+# building the engine itself needs no CUDA toolkit.
+#
+#   sm_75 .. sm_120   machine code for Turing (RTX 20xx) up to Blackwell
+#   compute_75        PTX the driver compiles for any newer GPU
+#   -fmad=false       no fused multiply-add: the mesher field must round
+#                     exactly like the CPU code (see hkgpu_kernels.cu)
+#   -std=c++20, -allow-unsupported-compiler
+#                     nvcc only preprocesses with the host compiler here (no
+#                     host code), which lets a newer GCC than nvcc lists work
+set -e
+cd "$(dirname "$0")"
+NVCC="${NVCC:-nvcc}"
+"$NVCC" -fatbin -O3 -fmad=false -std=c++20 -allow-unsupported-compiler \
+    -gencode arch=compute_75,code=sm_75 \
+    -gencode arch=compute_86,code=sm_86 \
+    -gencode arch=compute_89,code=sm_89 \
+    -gencode arch=compute_120,code=sm_120 \
+    -gencode arch=compute_75,code=compute_75 \
+    -o hkgpu_kernels.fatbin hkgpu_kernels.cu
+python3 - <<'EOF'
+data = open("hkgpu_kernels.fatbin", "rb").read()
+with open("hkgpu_kernels_fatbin.h", "w") as f:
+    f.write("// Generated by hkgpu_build_kernels.sh from hkgpu_kernels.cu — do not edit.\n")
+    f.write("#ifndef HKGPU_KERNELS_FATBIN_H\n#define HKGPU_KERNELS_FATBIN_H\n\n")
+    f.write("// 8-byte aligned: cuModuleLoadData reads the fatbin header in place\n")
+    f.write("alignas(8) static const unsigned char hkgpu_kernels_fatbin[] = {\n")
+    for i in range(0, len(data), 20):
+        f.write("    " + ", ".join("0x%02x" % b for b in data[i:i + 20]) + ",\n")
+    f.write("};\n\n#endif\n")
+print("hkgpu_kernels_fatbin.h:", len(data), "bytes")
+EOF
+rm -f hkgpu_kernels.fatbin
