+bool FluidSimulation::_smoothSurfaceMeshGPU(TriangleMesh &mesh) {
+    static_assert(sizeof(vmath::vec3) == 3 * sizeof(float), "vec3 must be three packed floats");
+    static_assert(sizeof(Triangle) == 3 * sizeof(int), "Triangle must be three packed ints");
+    int iterations = _surfaceReconstructionSmoothingIterations;
+    if (iterations <= 0 || mesh.vertices.empty()) {
+        return false;       // the CPU returns at once as well
+    }
+    // The GPU time covers the whole GPU path, the vertex copy included
+    StopWatch gpuTimer;
+    gpuTimer.start();
+    std::vector<vmath::vec3> smoothed = mesh.vertices;
+    bool ok = HKGPU::smoothMesh((float *)smoothed.data(), (int)smoothed.size(),
+                                (const int *)mesh.triangles.data(), (int)mesh.triangles.size(),
+                                _surfaceReconstructionSmoothingValue, iterations, HKGPU::STEP_MESH);
+    gpuTimer.stop();
+    if (!ok) {
+        return false;
+    }
+    if (HKGPU::isVerifyEnabled()) {
+        StopWatch cpuTimer;
+        cpuTimer.start();
+        mesh.smooth(_surfaceReconstructionSmoothingValue, iterations);
+        cpuTimer.stop();
+        HKGPU::addVerifyTiming(HKGPU::STEP_MESH, gpuTimer.getTime(), cpuTimer.getTime());
+        // Every coordinate, the unit of the other mesh comparisons
+        long long mismatches = 0;
+        const float *cv = (const float *)mesh.vertices.data();
+        const float *gv = (const float *)smoothed.data();
+        for (size_t c = 0; c < 3 * mesh.vertices.size(); c++) {
+            if (std::memcmp(&cv[c], &gv[c], sizeof(float)) != 0) {
+                mismatches++;
+            }
+        }
+        HKGPU::addVerifyResult(HKGPU::STEP_MESH, mismatches, 3 * (long long)mesh.vertices.size());
+        return true;
+    }
+    mesh.vertices = smoothed;
+    return true;
+}
