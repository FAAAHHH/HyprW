+void FluidSimulation::_initializeAdaptiveParticleAttribute() {
+    if (_markerParticles.getAttribute(_adaptiveParticleLevelName).id >= 0) {
+        return;
+    }
+    _markerParticles.addAttributeUChar(_adaptiveParticleLevelName, 0);
+    _markerParticles.update();
+}
+
+bool FluidSimulation::_hasMergedParticles() {
+    // Independent of the enable switch: merged particles need their special
+    // handling for as long as they exist
+    if (_markerParticles.getAttribute(_adaptiveParticleLevelName).id < 0) {
+        return false;
+    }
+
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+    for (size_t i = 0; i < levels->size(); i++) {
+        if (levels->at(i) != 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+double FluidSimulation::_adaptiveParticleScale(int level) {
+    // The volume doubles per level, so the radius grows by 2^(1/3)
+    return std::pow(2.0, (double)level / 3.0);
+}
+
+void FluidSimulation::_getStandardParticlePositions(std::vector<vmath::vec3> &out) {
+    std::vector<vmath::vec3> *positions;
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues("POSITION", positions);
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+
+    out.clear();
+    out.reserve(positions->size());
+    for (size_t i = 0; i < positions->size(); i++) {
+        if (levels->at(i) == 0) {
+            out.push_back(positions->at(i));
+        }
+    }
+}
+
+void FluidSimulation::_computeMergedParticleCoverage(Array3d<bool> &covered) {
+    // A merged particle of level L covers the cells whose centres lie within
+    // its level set radius 0.866 dx * 2^(L/3): the standard particle's sphere
+    // grown with the cube root of the volume. Merged particles stay at least
+    // that far below the surface, so covered cells are always liquid.
+    covered.fill(false);
+    if (_markerParticles.getAttribute(_adaptiveParticleLevelName).id < 0) {
+        return;
+    }
+
+    std::vector<vmath::vec3> *positions;
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues("POSITION", positions);
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+
+    std::vector<size_t> merged;
+    for (size_t pidx = 0; pidx < positions->size(); pidx++) {
+        if (levels->at(pidx) != 0) {
+            merged.push_back(pidx);
+        }
+    }
+    if (merged.empty()) {
+        return;
+    }
+
+    // Each thread writes only its own range of k slices: race free and the
+    // same result for any thread count
+    auto coverSlices = [&](int kbegin, int kend) {
+        for (size_t m = 0; m < merged.size(); m++) {
+            size_t pidx = merged[m];
+            double r = _liquidSDFParticleRadius * _adaptiveParticleScale(levels->at(pidx));
+            float rsq = (float)(r * r);
+            vmath::vec3 p = positions->at(pidx);
+            vmath::vec3 rv((float)r, (float)r, (float)r);
+            GridIndex gmin = Grid3d::positionToGridIndex(p - rv, _dx);
+            GridIndex gmax = Grid3d::positionToGridIndex(p + rv, _dx);
+            int kmin = std::max(gmin.k, kbegin);
+            int kmax = std::min(gmax.k, kend - 1);
+            if (kmin > kmax) {
+                continue;
+            }
+            int imin = std::max(gmin.i, 0);
+            int jmin = std::max(gmin.j, 0);
+            int imax = std::min(gmax.i, _isize - 1);
+            int jmax = std::min(gmax.j, _jsize - 1);
+
+            for (int k = kmin; k <= kmax; k++) {
+                for (int j = jmin; j <= jmax; j++) {
+                    for (int i = imin; i <= imax; i++) {
+                        vmath::vec3 c = Grid3d::GridIndexToCellCenter(i, j, k, _dx);
+                        if (vmath::lengthsq(c - p) <= rsq) {
+                            covered.set(i, j, k, true);
+                        }
+                    }
+                }
+            }
+        }
+    };
+
+    int numthreads = (int)fmin(ThreadUtils::getMaxThreadCount(), _ksize);
+    std::vector<int> intervals = ThreadUtils::splitRangeIntoIntervals(0, _ksize, numthreads);
+    std::vector<std::thread> threads(numthreads);
+    for (int t = 0; t < numthreads; t++) {
+        threads[t] = std::thread(coverSlices, intervals[t], intervals[t + 1]);
+    }
+    for (int t = 0; t < numthreads; t++) {
+        threads[t].join();
+    }
+}
+
+void FluidSimulation::_addMergedParticleCoverageToMask(ParticleMaskGrid &maskgrid) {
+    // Cells covered by merged particles are full: inflows and fluid objects
+    // must not add standard particles on top of them
+    if (!_hasMergedParticles()) {
+        return;
+    }
+
+    Array3d<bool> covered(_isize, _jsize, _ksize, false);
+    _computeMergedParticleCoverage(covered);
+    float h = (float)(0.25 * _dx);
+    for (int k = 0; k < _ksize; k++) {
+        for (int j = 0; j < _jsize; j++) {
+            for (int i = 0; i < _isize; i++) {
+                if (!covered(i, j, k)) {
+                    continue;
+                }
+                vmath::vec3 c = Grid3d::GridIndexToCellCenter(i, j, k, _dx);
+                for (int s = 0; s < 8; s++) {
+                    vmath::vec3 o((s & 1) ? h : -h, (s & 2) ? h : -h, (s & 4) ? h : -h);
+                    maskgrid.addParticle(c + o);
+                }
+            }
+        }
+    }
+}
+
+double FluidSimulation::_getAdaptiveParticleSpeedLimit() {
+    // With whitewater on, merged particles stay slower than the emitter's
+    // minimum speed sqrt(2 E_min): below it the energy potential is zero, so
+    // a merged particle emits exactly what its standard particles would have
+    // emitted, nothing. Without whitewater there is no speed limit.
+    if (!_isDiffuseMaterialOutputEnabled) {
+        return std::numeric_limits<double>::infinity();
+    }
+    return std::sqrt(2.0 * std::max(0.0, getMinDiffuseEmitterEnergy()));
+}
+
+void FluidSimulation::_computeAdaptiveParticleDepthGrids(Array3d<bool> &covered,
+                                                         unsigned char depthCap,
+                                                         unsigned char solidCap,
+                                                         std::vector<unsigned char> &depth,
+                                                         std::vector<unsigned char> &solidDistance) {
+    // Depth: the Chebyshev distance in cells from a liquid cell to the nearest
+    // air cell (never larger than the Euclidean distance, so the depth is
+    // never overestimated), as the number of 3x3x3 erosions of the "not air"
+    // mask the cell survives. Liquid are the cells holding a standard particle
+    // and the cells covered by merged particles; air is every other cell that
+    // is not solid. Solid distance: the same from solid cells and the domain
+    // boundary. Cells further away than the cap get the cap, which keeps
+    // every criterion on the safe side. Indices: i + isize * (j + jsize * k).
+    int ni = _isize;
+    int nj = _jsize;
+    int nk = _ksize;
+    size_t ncells = (size_t)ni * (size_t)nj * (size_t)nk;
+
+    std::vector<unsigned char> isLiquid(ncells, 0);
+    std::vector<unsigned char> isSolid(ncells, 0);
+
+    std::vector<vmath::vec3> *positions;
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues("POSITION", positions);
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+    for (size_t pidx = 0; pidx < positions->size(); pidx++) {
+        if (levels->at(pidx) != 0) {
+            continue;
+        }
+        GridIndex g = Grid3d::positionToGridIndex(positions->at(pidx), _dx);
+        if (g.i >= 0 && g.j >= 0 && g.k >= 0 && g.i < ni && g.j < nj && g.k < nk) {
+            isLiquid[(size_t)g.i + (size_t)ni * ((size_t)g.j + (size_t)nj * (size_t)g.k)] = 1;
+        }
+    }
+
+    for (int k = 0; k < nk; k++) {
+        for (int j = 0; j < nj; j++) {
+            for (int i = 0; i < ni; i++) {
+                size_t idx = (size_t)i + (size_t)ni * ((size_t)j + (size_t)nj * (size_t)k);
+                if (covered(i, j, k)) {
+                    isLiquid[idx] = 1;
+                }
+                bool isBorder = i == 0 || j == 0 || k == 0 || i == ni - 1 || j == nj - 1 || k == nk - 1;
+                if (isBorder || _solidSDF.getDistanceAtCellCenter(i, j, k) < 0.0f) {
+                    isSolid[idx] = 1;
+                    isLiquid[idx] = 0;
+                }
+            }
+        }
+    }
+
+    // One 3x3x3 erosion as three separable passes; outside the grid counts
+    // as 'outside'
+    std::vector<unsigned char> tmpA(ncells), tmpB(ncells);
+    auto erode = [&](std::vector<unsigned char> &mask, unsigned char outside) {
+        for (int k = 0; k < nk; k++) {
+            for (int j = 0; j < nj; j++) {
+                size_t row = (size_t)ni * ((size_t)j + (size_t)nj * (size_t)k);
+                for (int i = 0; i < ni; i++) {
+                    unsigned char a = i > 0 ? mask[row + i - 1] : outside;
+                    unsigned char b = i < ni - 1 ? mask[row + i + 1] : outside;
+                    tmpA[row + i] = std::min(mask[row + i], std::min(a, b));
+                }
+            }
+        }
+        size_t strideJ = (size_t)ni;
+        for (int k = 0; k < nk; k++) {
+            for (int j = 0; j < nj; j++) {
+                size_t row = (size_t)ni * ((size_t)j + (size_t)nj * (size_t)k);
+                for (int i = 0; i < ni; i++) {
+                    unsigned char a = j > 0 ? tmpA[row + i - strideJ] : outside;
+                    unsigned char b = j < nj - 1 ? tmpA[row + i + strideJ] : outside;
+                    tmpB[row + i] = std::min(tmpA[row + i], std::min(a, b));
+                }
+            }
+        }
+        size_t strideK = (size_t)ni * (size_t)nj;
+        for (int k = 0; k < nk; k++) {
+            for (int j = 0; j < nj; j++) {
+                size_t row = (size_t)ni * ((size_t)j + (size_t)nj * (size_t)k);
+                for (int i = 0; i < ni; i++) {
+                    unsigned char a = k > 0 ? tmpB[row + i - strideK] : outside;
+                    unsigned char b = k < nk - 1 ? tmpB[row + i + strideK] : outside;
+                    mask[row + i] = std::min(tmpB[row + i], std::min(a, b));
+                }
+            }
+        }
+    };
+
+    // dist = 0 where the start mask is 0; otherwise the first erosion step at
+    // which the cell drops out of the mask, or the cap
+    auto distance = [&](std::vector<unsigned char> &mask, unsigned char cap, unsigned char outside,
+                        std::vector<unsigned char> &dist) {
+        dist.assign(ncells, 0);
+        for (size_t idx = 0; idx < ncells; idx++) {
+            if (mask[idx]) {
+                dist[idx] = cap;
+            }
+        }
+        for (unsigned char step = 1; step < cap; step++) {
+            erode(mask, outside);
+            bool any = false;
+            for (size_t idx = 0; idx < ncells; idx++) {
+                if (dist[idx] == cap && !mask[idx]) {
+                    dist[idx] = step;
+                }
+                any = any || mask[idx];
+            }
+            if (!any) {
+                break;
+            }
+        }
+    };
+
+    // Depth: the mask is "not air"; solid cells are not air, the domain
+    // border is solid
+    std::vector<unsigned char> mask(ncells);
+    for (size_t idx = 0; idx < ncells; idx++) {
+        mask[idx] = (isLiquid[idx] || isSolid[idx]) ? 1 : 0;
+    }
+    distance(mask, depthCap, 1, depth);
+
+    // Solid distance: the mask is "not solid"
+    for (size_t idx = 0; idx < ncells; idx++) {
+        mask[idx] = isSolid[idx] ? 0 : 1;
+    }
+    distance(mask, solidCap, 0, solidDistance);
+}
+
+void FluidSimulation::_transferMergedParticleVelocities() {
+    // Faces that no standard particle reached get the mass weighted average of
+    // the merged particles around them: a tent kernel one cell wide up to
+    // level 3 (about one merged particle per cell), growing with the particle
+    // spacing beyond, weighted with the volume 2^L. Standard particles keep
+    // priority, so the transfer near the surface is exactly the usual one.
+    std::vector<vmath::vec3> *positions, *velocities;
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues("POSITION", positions);
+    _markerParticles.getAttributeValues("VELOCITY", velocities);
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+
+    std::vector<size_t> merged;
+    for (size_t pidx = 0; pidx < positions->size(); pidx++) {
+        if (levels->at(pidx) != 0) {
+            merged.push_back(pidx);
+        }
+    }
+
+    // APIC: the affine part travels along, as in the standard transfer
+    std::vector<vmath::vec3> *affine[3] = {nullptr, nullptr, nullptr};
+    if (_velocityTransferMethod == VelocityTransferMethod::APIC) {
+        _markerParticles.getAttributeValues("AFFINEX", affine[0]);
+        _markerParticles.getAttributeValues("AFFINEY", affine[1]);
+        _markerParticles.getAttributeValues("AFFINEZ", affine[2]);
+    }
+
+    float eps = 1e-6f;
+    for (int dir = 0; dir < 3; dir++) {
+        Array3d<float> *grid = nullptr;
+        Array3d<bool> *valid = nullptr;
+        vmath::vec3 offset;
+        if (dir == 0) {
+            grid = _MACVelocity.getArray3dU();
+            valid = &(_validVelocities.validU);
+            offset = vmath::vec3(0.0f, 0.5f, 0.5f);
+        } else if (dir == 1) {
+            grid = _MACVelocity.getArray3dV();
+            valid = &(_validVelocities.validV);
+            offset = vmath::vec3(0.5f, 0.0f, 0.5f);
+        } else {
+            grid = _MACVelocity.getArray3dW();
+            valid = &(_validVelocities.validW);
+            offset = vmath::vec3(0.5f, 0.5f, 0.0f);
+        }
+
+        int ni = grid->width;
+        int nj = grid->height;
+        int nk = grid->depth;
+        size_t n = (size_t)ni * (size_t)nj * (size_t)nk;
+        std::vector<float> sum(n, 0.0f);
+        std::vector<float> weight(n, 0.0f);
+
+        // Each thread owns a range of k slices of faces and adds the merged
+        // particles in index order: the same sums for any thread count
+        auto splatSlices = [&](int kbegin, int kend) {
+            for (size_t m = 0; m < merged.size(); m++) {
+                size_t pidx = merged[m];
+                int level = levels->at(pidx);
+                double w = std::max(1.0, std::pow(2.0, (double)(level - 3) / 3.0));
+                double mass = std::pow(2.0, (double)level);
+                vmath::vec3 q = positions->at(pidx) / (float)_dx - offset;
+                int kmin = std::max((int)std::ceil(q.z - w), kbegin);
+                int kmax = std::min((int)std::floor(q.z + w), kend - 1);
+                if (kmin > kmax) {
+                    continue;
+                }
+
+                vmath::vec3 v = velocities->at(pidx);
+                float vc = dir == 0 ? v.x : (dir == 1 ? v.y : v.z);
+                vmath::vec3 c = affine[dir] != nullptr ? affine[dir]->at(pidx) : vmath::vec3();
+                vmath::vec3 p = positions->at(pidx);
+                int imin = std::max((int)std::ceil(q.x - w), 0);
+                int jmin = std::max((int)std::ceil(q.y - w), 0);
+                int imax = std::min((int)std::floor(q.x + w), ni - 1);
+                int jmax = std::min((int)std::floor(q.y + w), nj - 1);
+                for (int k = kmin; k <= kmax; k++) {
+                    double wz = 1.0 - std::abs(q.z - k) / w;
+                    if (wz <= 0.0) { continue; }
+                    for (int j = jmin; j <= jmax; j++) {
+                        double wy = 1.0 - std::abs(q.y - j) / w;
+                        if (wy <= 0.0) { continue; }
+                        for (int i = imin; i <= imax; i++) {
+                            double wx = 1.0 - std::abs(q.x - i) / w;
+                            if (wx <= 0.0 || valid->get(i, j, k)) { continue; }
+                            size_t idx = (size_t)i + (size_t)ni * ((size_t)j + (size_t)nj * (size_t)k);
+                            float wt = (float)(mass * wx * wy * wz);
+                            float vf = vc;
+                            if (affine[dir] != nullptr) {
+                                vmath::vec3 face = (vmath::vec3((float)i, (float)j, (float)k) + offset) * (float)_dx;
+                                vf += vmath::dot(c, face - p);
+                            }
+                            sum[idx] += wt * vf;
+                            weight[idx] += wt;
+                        }
+                    }
+                }
+            }
+        };
+
+        int numthreads = (int)fmin(ThreadUtils::getMaxThreadCount(), nk);
+        std::vector<int> intervals = ThreadUtils::splitRangeIntoIntervals(0, nk, numthreads);
+        std::vector<std::thread> threads(numthreads);
+        for (int t = 0; t < numthreads; t++) {
+            threads[t] = std::thread(splatSlices, intervals[t], intervals[t + 1]);
+        }
+        for (int t = 0; t < numthreads; t++) {
+            threads[t].join();
+        }
+
+        for (int k = 0; k < nk; k++) {
+            for (int j = 0; j < nj; j++) {
+                for (int i = 0; i < ni; i++) {
+                    size_t idx = (size_t)i + (size_t)ni * ((size_t)j + (size_t)nj * (size_t)k);
+                    if (weight[idx] > eps) {
+                        grid->set(i, j, k, sum[idx] / weight[idx]);
+                        valid->set(i, j, k, true);
+                    }
+                }
+            }
+        }
+    }
+}
+
+int FluidSimulation::_splitAdaptiveParticles(std::vector<unsigned char> &target) {
+    // Each halving makes two particles of the next lower level, placed
+    // symmetrically around the parent along a random direction, half the
+    // lower level's spacing apart; both keep the parent's velocity and
+    // attributes, so mass and momentum are kept (Adams et al. 2007). A child
+    // that would land in a solid stays at the parent's position. 'target' is
+    // the level each particle must reach; it grows with the new particles.
+    std::vector<vmath::vec3> *positions;
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+
+    std::vector<size_t> parents;
+    for (size_t i = 0; i < target.size() && i < levels->size(); i++) {
+        if (target[i] < levels->at(i)) {
+            parents.push_back(i);
+        }
+    }
+
+    int numSplit = 0;
+    while (!parents.empty()) {
+        size_t first = _markerParticles.appendCopies(parents);
+        _markerParticles.getAttributeValues("POSITION", positions);
+        _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+        target.resize(_markerParticles.size());
+
+        // The copies are new particles for the particle export: a fresh ID,
+        // and a UID that the attribute update assigns (as _addMarkerParticles)
+        if (_isFluidParticleIDAttributeEnabled || _isFluidParticleUIDAttributeEnabled) {
+            std::vector<uint16_t> *ids = nullptr;
+            std::vector<int> *uids = nullptr;
+            if (_isFluidParticleIDAttributeEnabled) {
+                _markerParticles.getAttributeValues("ID", ids);
+            }
+            if (_isFluidParticleUIDAttributeEnabled) {
+                _markerParticles.getAttributeValues("UID", uids);
+            }
+            int idLimit = _getFluidParticleOutputIDLimit();
+            for (size_t k = 0; k < parents.size(); k++) {
+                uint16_t id = 0;
+                if (ids != nullptr) {
+                    id = _generateRandomFluidParticleID();
+                    ids->at(first + k) = id;
+                }
+                if (uids != nullptr) {
+                    uids->at(first + k) = id < idLimit ? (int)UIDAttribute::unset : (int)UIDAttribute::ignore;
+                }
+            }
+        }
+
+        std::vector<size_t> next;
+        for (size_t k = 0; k < parents.size(); k++) {
+            size_t a = parents[k];
+            size_t b = first + k;
+            int level = levels->at(a) - 1;
+            float delta = (float)(0.25 * _dx * _adaptiveParticleScale(level));
+            double z = _randomDouble(-1.0, 1.0);
+            double angle = _randomDouble(0.0, 2.0 * 3.141592653589793);
+            double s = std::sqrt(std::max(0.0, 1.0 - z * z));
+            vmath::vec3 u((float)(s * std::cos(angle)), (float)(s * std::sin(angle)), (float)z);
+
+            vmath::vec3 p = positions->at(a);
+            vmath::vec3 pa = p - delta * u;
+            vmath::vec3 pb = p + delta * u;
+            if (_solidSDF.trilinearInterpolate(pa) < 0.0f) {
+                pa = p;
+            }
+            if (_solidSDF.trilinearInterpolate(pb) < 0.0f) {
+                pb = p;
+            }
+            positions->at(a) = pa;
+            positions->at(b) = pb;
+            levels->at(a) = (unsigned char)level;
+            levels->at(b) = (unsigned char)level;
+            target[b] = target[a];
+            if (level > target[a]) {
+                next.push_back(a);
+                next.push_back(b);
+            }
+            numSplit++;
+        }
+        parents.swap(next);
+    }
+    return numSplit;
+}
+
+int FluidSimulation::_splitMergedParticlesNearSurface(double dt) {
+    // Cheap check between the regular passes: a merged particle splits down
+    // to the standard size at once if the level set shows air within its
+    // radius plus 2 cells in any of the six axis directions or ahead along
+    // its velocity (plus the distance it travels in this step), if it is
+    // closer to a solid than the obstacle distance, or if it became fast
+    // enough to emit whitewater.
+    std::vector<vmath::vec3> *positions, *velocities;
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues("POSITION", positions);
+    _markerParticles.getAttributeValues("VELOCITY", velocities);
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+
+    double solidMin = (double)_adaptiveParticleSolidDistance * _dx;
+    double speedLimit = _getAdaptiveParticleSpeedLimit();
+    size_t n = _markerParticles.size();
+    std::vector<unsigned char> target(n);
+    bool isAny = false;
+    for (size_t i = 0; i < n; i++) {
+        int level = levels->at(i);
+        target[i] = (unsigned char)level;
+        if (level == 0) {
+            continue;
+        }
+
+        vmath::vec3 p = positions->at(i);
+        vmath::vec3 v = velocities->at(i);
+        float reach = (float)((_liquidSDFParticleRadius / _dx * _adaptiveParticleScale(level) + 2.0) * _dx);
+        bool isNearAir = _liquidSDF.trilinearInterpolate(p) >= 0.0f;
+        for (int a = 0; a < 6 && !isNearAir; a++) {
+            vmath::vec3 e((a == 0) - (a == 1), (a == 2) - (a == 3), (a == 4) - (a == 5));
+            isNearAir = _liquidSDF.trilinearInterpolate(p + reach * e) >= 0.0f;
+        }
+        float speed = vmath::length(v);
+        if (!isNearAir && speed > 1e-6f) {
+            vmath::vec3 ahead = p + ((reach + speed * (float)dt) / speed) * v;
+            isNearAir = _liquidSDF.trilinearInterpolate(ahead) >= 0.0f;
+        }
+        bool isNearSolid = _solidSDF.trilinearInterpolate(p) < solidMin;
+        bool isFast = speed >= speedLimit;
+        if (isNearAir || isNearSolid || isFast) {
+            target[i] = 0;
+            isAny = true;
+        }
+    }
+
+    if (!isAny) {
+        return 0;
+    }
+    int numSplit = _splitAdaptiveParticles(target);
+    _adaptiveParticleLastSplits += numSplit;
+    return numSplit;
+}
+
+void FluidSimulation::_updateAdaptiveParticleSizes(double dt) {
+    // Switched off, merged particles that still exist keep splitting where
+    // needed; only new merging stops
+    if (!_isFluidInSimulation() || (!_isAdaptiveParticlesEnabled && !_hasMergedParticles())) {
+        return;
+    }
+
+    StopWatch t;
+    t.start();
+
+    _initializeAdaptiveParticleAttribute();
+    bool isMergeEnabled = _isAdaptiveParticlesEnabled;
+
+    // Regular splits and merges once per split time: one halving per particle
+    _adaptiveParticleTime += dt;
+    bool isRegularPass = false;
+    if (_adaptiveParticleTime >= _adaptiveParticleNextPassTime) {
+        isRegularPass = true;
+        while (_adaptiveParticleNextPassTime <= _adaptiveParticleTime) {
+            _adaptiveParticleNextPassTime += _adaptiveParticleSplitTime;
+        }
+    }
+
+    if (!isRegularPass) {
+        // Between the regular passes only merged particles that are about to
+        // reach the air or an obstacle split, found by sampling the level set
+        if (_hasMergedParticles()) {
+            int numSplit = _splitMergedParticlesNearSurface(dt);
+            if (numSplit > 0) {
+                _logfile.log(std::ostringstream().flush() << _logfile.getTime() <<
+                             " Adaptive particles: " << numSplit << " split near the surface" <<
+                             std::endl);
+            }
+        }
+        t.stop();
+        _timingData.advanceMarkerParticles += t.getTime();
+        return;
+    }
+
+    std::vector<vmath::vec3> *positions, *velocities;
+    std::vector<unsigned char> *levels;
+    _markerParticles.getAttributeValues("POSITION", positions);
+    _markerParticles.getAttributeValues("VELOCITY", velocities);
+    _markerParticles.getAttributeValues(_adaptiveParticleLevelName, levels);
+
+    int maxLevel = std::min(_adaptiveParticleMaxLevel, _adaptiveParticleMaxLevelLimit);
+    double alpha = _adaptiveParticleSplitFactor;
+    double beta = std::max(_adaptiveParticleMergeFactor, _adaptiveParticleSplitFactor);
+    double splitTime = _adaptiveParticleSplitTime;
+    double solidMin = (double)_adaptiveParticleSolidDistance;
+
+    // Per level, in cells: the radius (the level set radius grows with the
+    // cube root of the volume) and the depths below the surface at which a
+    // particle splits at once, splits at the next pass, or may be merged into
+    // that level. The merge depth always lies at least one cell above both
+    // split depths, whatever the factors are, so nothing flickers.
+    double R[8], immediateDepth[8], splitDepth[8], mergeDepth[8];
+    for (int level = 0; level < 8; level++) {
+        R[level] = (_liquidSDFParticleRadius / _dx) * _adaptiveParticleScale(level);
+        immediateDepth[level] = R[level] + 2.0;
+        splitDepth[level] = alpha * R[level] + 1.0;
+        mergeDepth[level] = std::max(beta * R[level] + 1.0,
+                                     std::max(splitDepth[level], immediateDepth[level]) + 1.0);
+    }
+    // Obstacles: split closer than solidMin + R, merge only one cell further
+    // away. Whitewater: merged particles stay below the emitter speed.
+    double speedLimit = _getAdaptiveParticleSpeedLimit() / _dx;
+
+    StopWatch tGrids;
+    tGrids.start();
+
+    // The distances only need to reach as deep as the deepest criterion that
+    // can be met, the merge into the maximum level, plus 6 cells for the
+    // look-ahead. A capped cell is AT LEAST that deep: it may hold back a
+    // merge of a fast particle, but it never triggers a split.
+    unsigned char depthCap = (unsigned char)std::min(64.0, std::ceil(mergeDepth[std::max(maxLevel, 1)]) + 6.0);
+    unsigned char solidCap = (unsigned char)std::min(64.0, solidMin + std::ceil(R[maxLevel]) + 3.0);
+
+    Array3d<bool> covered(_isize, _jsize, _ksize, false);
+    _computeMergedParticleCoverage(covered);
+    std::vector<unsigned char> depth, solidDistance;
+    _computeAdaptiveParticleDepthGrids(covered, depthCap, solidCap, depth, solidDistance);
+
+    tGrids.stop();
+    StopWatch tPass;
+    tPass.start();
+
+    auto cellIndex = [&](vmath::vec3 p, size_t &flat) -> bool {
+        GridIndex g = Grid3d::positionToGridIndex(p, _dx);
+        if (g.i < 0 || g.j < 0 || g.k < 0 || g.i >= _isize || g.j >= _jsize || g.k >= _ksize) {
+            return false;
+        }
+        flat = (size_t)g.i + (size_t)_isize * ((size_t)g.j + (size_t)_jsize * (size_t)g.k);
+        return true;
+    };
+
+    // 1. Decide per particle. Depths are in cells, speeds in cells per
+    //    second; '+ 1' is the uncertainty of a particle's position in its cell.
+    size_t n = _markerParticles.size();
+    std::vector<unsigned char> target(n);
+    std::vector<bool> isCandidate(n, false);
+    for (size_t i = 0; i < n; i++) {
+        int level = levels->at(i);
+        target[i] = (unsigned char)level;
+        size_t flat;
+        if (!cellIndex(positions->at(i), flat)) {
+            continue;
+        }
+        double d = depth[flat];
+        bool isDeep = depth[flat] >= depthCap;
+        double sd = solidDistance[flat];
+        double speed = vmath::length(velocities->at(i)) / _dx;
+
+        if (level > 0) {
+            double dNow = d - speed * dt;
+            if ((!isDeep && dNow < immediateDepth[level]) || sd < solidMin || speed >= speedLimit) {
+                // Reaches the air or an obstacle within this step, or fast
+                // enough to emit whitewater: split now, as far down as needed
+                int l = level - 1;
+                while (l > 0 && ((!isDeep && dNow < splitDepth[l]) ||
+                                 sd < solidMin + std::ceil(R[l]) || speed >= speedLimit)) {
+                    l--;
+                }
+                target[i] = (unsigned char)l;
+                continue;
+            }
+            // Would reach the split depth before it could halve its way down
+            double dAhead = d - speed * (dt + level * splitTime);
+            if ((!isDeep && dAhead < splitDepth[level]) || sd < solidMin + std::ceil(R[level])) {
+                target[i] = (unsigned char)(level - 1);
+                continue;
+            }
+        }
+
+        if (isMergeEnabled && level < maxLevel && speed < 0.9 * speedLimit) {
+            double dAhead = d - speed * (dt + (level + 1) * splitTime);
+            if (dAhead >= mergeDepth[level + 1] && sd >= solidMin + std::ceil(R[level + 1]) + 1.0) {
+                isCandidate[i] = true;
+            }
+        }
+    }
+
+    // 2. Merge pairs of candidates of the same level, nearest partner first;
+    //    mass, momentum and the averaged attributes are kept (Adams et al.
+    //    2007: the merged particle sits at the midpoint)
+    std::vector<size_t> removed;
+    int numMerged = 0;
+    if (isRegularPass) {
+        // Candidates grouped by cell (counting sort, index order kept)
+        size_t ncells = (size_t)_isize * (size_t)_jsize * (size_t)_ksize;
+        std::vector<size_t> cellOf(n, ncells);
+        std::vector<int> cellStart(ncells + 1, 0);
+        for (size_t i = 0; i < n; i++) {
+            size_t flat;
+            if (isCandidate[i] && cellIndex(positions->at(i), flat)) {
+                cellOf[i] = flat;
+                cellStart[flat + 1]++;
+            }
+        }
+        for (size_t c = 0; c < ncells; c++) {
+            cellStart[c + 1] += cellStart[c];
+        }
+        std::vector<size_t> cellParticles((size_t)cellStart[ncells]);
+        std::vector<int> fill(cellStart.begin(), cellStart.end() - 1);
+        for (size_t i = 0; i < n; i++) {
+            if (cellOf[i] != ncells) {
+                cellParticles[(size_t)fill[cellOf[i]]++] = i;
+            }
+        }
+
+        // Only particles of the same fluid merge: the same source, density
+        // and viscosity, where the simulation tracks them
+        std::vector<int> *sourceIDs = nullptr;
+        std::vector<float> *densities = nullptr, *viscosities = nullptr;
+        if (_markerParticles.getAttribute("SOURCEID").id >= 0) {
+            _markerParticles.getAttributeValues("SOURCEID", sourceIDs);
+        }
+        if (_markerParticles.getAttribute("DENSITY").id >= 0) {
+            _markerParticles.getAttributeValues("DENSITY", densities);
+        }
+        if (_markerParticles.getAttribute("VISCOSITY").id >= 0) {
+            _markerParticles.getAttributeValues("VISCOSITY", viscosities);
+        }
+        auto isSameFluid = [&](size_t a, size_t b) -> bool {
+            if (sourceIDs != nullptr && sourceIDs->at(a) != sourceIDs->at(b)) {
+                return false;
+            }
+            if (densities != nullptr &&
+                    std::abs(densities->at(a) - densities->at(b)) > 1e-6f * std::max(1.0f, std::abs(densities->at(a)))) {
+                return false;
+            }
+            if (viscosities != nullptr &&
+                    std::abs(viscosities->at(a) - viscosities->at(b)) > 1e-6f * std::max(1.0f, std::abs(viscosities->at(a)))) {
+                return false;
+            }
+            return true;
+        };
+
+        std::vector<bool> isUsed(n, false);
+        auto searchCell = [&](size_t i, int level, vmath::vec3 p, int qi, int qj, int qk,
+                              double &bestDistanceSq, size_t &best) {
+            if (qi < 0 || qj < 0 || qk < 0 || qi >= _isize || qj >= _jsize || qk >= _ksize) {
+                return;
+            }
+            size_t key = (size_t)qi + (size_t)_isize * ((size_t)qj + (size_t)_jsize * (size_t)qk);
+            for (int c = cellStart[key]; c < cellStart[key + 1]; c++) {
+                size_t j = cellParticles[(size_t)c];
+                if (j == i || isUsed[j] || levels->at(j) != level || !isSameFluid(i, j)) {
+                    continue;
+                }
+                double dsq = vmath::lengthsq(positions->at(j) - p);
+                if (dsq < bestDistanceSq) {
+                    bestDistanceSq = dsq;
+                    best = j;
+                }
+            }
+        };
+
+        for (size_t i = 0; i < n; i++) {
+            if (cellOf[i] == ncells || isUsed[i]) {
+                continue;
+            }
+
+            int level = levels->at(i);
+            vmath::vec3 p = positions->at(i);
+            // Partners within 1.5 times the mean spacing 0.5 dx * 2^(L/3); the
+            // own cell first, the neighbours only if it holds no partner
+            double maxDistance = 0.75 * _dx * _adaptiveParticleScale(level);
+            double bestDistanceSq = maxDistance * maxDistance;
+            size_t best = n;
+            GridIndex g = Grid3d::positionToGridIndex(p, _dx);
+            searchCell(i, level, p, g.i, g.j, g.k, bestDistanceSq, best);
+            if (best == n) {
+                int cellReach = (int)std::ceil(maxDistance / _dx);
+                for (int dk = -cellReach; dk <= cellReach; dk++) {
+                    for (int dj = -cellReach; dj <= cellReach; dj++) {
+                        for (int di = -cellReach; di <= cellReach; di++) {
+                            if (di == 0 && dj == 0 && dk == 0) {
+                                continue;
+                            }
+                            searchCell(i, level, p, g.i + di, g.j + dj, g.k + dk,
+                                       bestDistanceSq, best);
+                        }
+                    }
+                }
+            }
+            if (best == n) {
+                continue;
+            }
+
+            // The merged particle has to meet the criterion where it will be
+            vmath::vec3 m = 0.5f * (p + positions->at(best));
+            size_t flat;
+            if (!cellIndex(m, flat)) {
+                continue;
+            }
+            double speed = 0.5 * vmath::length(velocities->at(i) + velocities->at(best)) / _dx;
+            double dAhead = depth[flat] - speed * (dt + (level + 1) * splitTime);
+            if (dAhead < mergeDepth[level + 1] || speed >= 0.9 * speedLimit ||
+                    solidDistance[flat] < solidMin + std::ceil(R[level + 1]) + 1.0) {
+                continue;
+            }
+
+            isUsed[i] = true;
+            isUsed[best] = true;
+            _markerParticles.averageInto(i, best);
+            levels->at(i) = (unsigned char)(level + 1);
+            target[i] = (unsigned char)(level + 1);
+            removed.push_back(best);
+            numMerged++;
+        }
+    }
+
+    // 3. Split
+    int numSplit = _splitAdaptiveParticles(target);
+
+    if (!removed.empty()) {
+        std::vector<bool> isRemoved(_markerParticles.size(), false);
+        for (size_t r = 0; r < removed.size(); r++) {
+            isRemoved[removed[r]] = true;
+        }
+        _markerParticles.removeParticles(isRemoved);
+    }
+
+    _adaptiveParticleLastMerges = numMerged;
+    _adaptiveParticleLastSplits = numSplit;
+
+    tPass.stop();
+    t.stop();
+    _timingData.advanceMarkerParticles += t.getTime();
+
+    _logfile.log(std::ostringstream().flush() << _logfile.getTime() <<
+                 " Adaptive particles: " << numMerged << " merged, " <<
+                 numSplit << " split, grids " << (int)(1000 * tGrids.getTime()) <<
+                 " ms (depth cap " << (int)depthCap << "), pass " <<
+                 (int)(1000 * tPass.getTime()) << " ms" <<
+                 (isRegularPass ? " (regular)" : "") << std::endl);
+}
