+bool ParticleMesher::_isInteriorNode(vmath::vec3 p) {
+    GridIndex g = Grid3d::positionToGridIndex(p, _dx);
+    return _interiorCells->isIndexInRange(g) && _interiorCells->get(g);
+}
+
+void ParticleMesher::_anisoCalibrate(MesherComputeChunkData &data) {
+    // HydroKit: the surface threshold that encloses the particles' volume.
+    // Every marker particle stands for dx^3 / 8
+    // (FluidSimulation::_initializeParticleRadii), a cell of merged particles
+    // for dx^3. A fixed threshold lost 23 % of the water in the prototype
+    // (sparse spray and churned pools fall below it) and broke the pool into
+    // "crushed ice". Calibrated, the engine's mesh holds +1.0 % at mesh detail
+    // 2, +0.4 % at 3 (learning scene, frames 106-120).
+    // Obstacles and the domain walls: the polygonizer cuts the surface at the
+    // solid's zero level (Polygonizer3d::_vertexInterp), so each node counts
+    // with the part of its cell outside the solid. Learning scene, frames
+    // 106-108, 8.43 m3 of particles: counting solid nodes fully gave 8.08 m3,
+    // leaving them out 8.73 m3.
+    const int nbins = 16384;
+    const double maxValue = 4.0;
+    std::vector<double> histogram(nbins, 0.0);
+    for (size_t cidx = 0; cidx < data.computeChunks.size(); cidx++) {
+        MesherComputeChunk c = data.computeChunks[cidx];
+        std::vector<float> phi;
+        _aniso.computeField(c.positionOffset, c.isize, c.jsize, c.ksize, _subdx, phi);
+
+        // a chunk's last node layer is the next chunk's first
+        int ie = c.isize, je = c.jsize, ke = c.ksize;
+        if (cidx + 1 < data.computeChunks.size()) {
+            if (c.splitDirection == Direction::U) {
+                ie--;
+            } else if (c.splitDirection == Direction::V) {
+                je--;
+            } else {
+                ke--;
+            }
+        }
+        for (int k = 0; k < ke; k++) {
+            for (int j = 0; j < je; j++) {
+                for (int i = 0; i < ie; i++) {
+                    double v = phi[(size_t)i + (size_t)c.isize * ((size_t)j + (size_t)c.jsize * k)];
+                    vmath::vec3 p = c.positionOffset + Grid3d::GridIndexToPosition(i, j, k, _subdx);
+                    if (_interiorCells != nullptr && _isInteriorNode(p)) {
+                        v = maxValue;
+                    }
+                    if (v <= 0.0) {
+                        continue;
+                    }
+                    double outside = 0.5 + _solidSDF->trilinearInterpolate(p) / _subdx;
+                    if (outside <= 0.0) {
+                        continue;
+                    }
+                    int b = std::min(nbins - 1, (int)(v / maxValue * nbins));
+                    histogram[b] += std::min(outside, 1.0);
+                }
+            }
+        }
+    }
+
+    double cellVolume = _dx * _dx * _dx;
+    double target = (double)_particles->size() * cellVolume / 8.0;
+    if (_interiorCells != nullptr) {
+        long long interior = 0;
+        for (int k = 0; k < _interiorCells->depth; k++) {
+            for (int j = 0; j < _interiorCells->height; j++) {
+                for (int i = 0; i < _interiorCells->width; i++) {
+                    if (_interiorCells->get(i, j, k)) {
+                        interior++;
+                    }
+                }
+            }
+        }
+        target += (double)interior * cellVolume;
+    }
+    double targetNodes = target / (_subdx * _subdx * _subdx);
+
+    // Thin spray alone may hold less than its volume above any threshold:
+    // then the lowest threshold that still separates drops is used
+    const double minThreshold = 0.02;
+    const double maxThreshold = 0.95;
+    double threshold = minThreshold;
+    double sum = 0.0;
+    for (int b = nbins - 1; b >= 0; b--) {
+        if (histogram[b] > 0.0 && sum + histogram[b] >= targetNodes) {
+            double frac = (targetNodes - sum) / histogram[b];
+            threshold = (b + 1 - frac) * maxValue / nbins;
+            break;
+        }
+        sum += histogram[b];
+    }
+    _anisoThreshold = std::min(std::max(threshold, minThreshold), maxThreshold);
+    _interiorValue = (float)std::max(1.0 - _anisoThreshold, 0.05);
+}
+
+void ParticleMesher::_computeScalarFieldAniso(ScalarFieldData &fieldData) {
+    Array3d<float> *fieldValues = fieldData.fieldValues.getPointerToScalarField();
+    int isize = fieldValues->width;
+    int jsize = fieldValues->height;
+    int ksize = fieldValues->depth;
+    std::vector<float> phi;
+    _aniso.computeField(fieldData.computeChunk.positionOffset, isize, jsize, ksize, _subdx, phi);
+    float threshold = (float)_anisoThreshold;
+    for (int k = 0; k < ksize; k++) {
+        for (int j = 0; j < jsize; j++) {
+            for (int i = 0; i < isize; i++) {
+                fieldValues->set(i, j, k, phi[(size_t)i + (size_t)isize * ((size_t)j + (size_t)jsize * k)] - threshold);
+            }
+        }
+    }
+}
+
+void ParticleMesher::_mergeGPUPreviewValues(ScalarField &target) {
+    int pi = _pisize + 1;
+    int pj = _pjsize + 1;
+    int pk = _pksize + 1;
+    for (int k = 0; k < pk; k++) {
+        for (int j = 0; j < pj; j++) {
+            for (int i = 0; i < pi; i++) {
+                size_t idx = (size_t)i + (size_t)pi * ((size_t)j + (size_t)pj * (size_t)k);
+                if (_gpuPreviewSet[idx]) {
+                    target.setScalarFieldValue(i, j, k, _gpuPreviewValues[idx]);
+                }
+            }
+        }
+    }
+}
