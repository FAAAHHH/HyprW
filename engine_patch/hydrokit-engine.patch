+bool VelocityAdvector::_advectGridGPU(Direction dir) {
+    static_assert(sizeof(vmath::vec3) == 3 * sizeof(float), "vec3 must be three packed floats");
+
+    // The GPU way's whole cost, including the block setup it shares with the CPU way
+    StopWatch gpuTimer;
+    gpuTimer.start();
+    BlockArray3d<ScalarData> blockphi;
+    _initializeBlockGrid(blockphi, dir);
+
+    Array3d<float> *vfieldgrid = NULL;
+    Array3d<bool> *validgrid = NULL;
+    int component = 0;
+    if (dir == Direction::U) {
+        vfieldgrid = _vfield->getArray3dU();
+        validgrid = &(_validVelocities->validU);
+        component = 0;
+    } else if (dir == Direction::V) {
+        vfieldgrid = _vfield->getArray3dV();
+        validgrid = &(_validVelocities->validV);
+        component = 1;
+    } else {
+        vfieldgrid = _vfield->getArray3dW();
+        validgrid = &(_validVelocities->validW);
+        component = 2;
+    }
+
+    BlockArray3dParameters blockParams;
+    blockParams.isize = vfieldgrid->width;
+    blockParams.jsize = vfieldgrid->height;
+    blockParams.ksize = vfieldgrid->depth;
+    blockParams.blockwidth = _chunkWidth;
+    Dims3d blockDims = BlockArray3d<ScalarData>::getBlockDimensions(blockParams);
+    std::vector<unsigned char> blockActive((size_t)blockDims.i * blockDims.j * blockDims.k, 0);
+    for (int k = 0; k < blockDims.k; k++) {
+        for (int j = 0; j < blockDims.j; j++) {
+            for (int i = 0; i < blockDims.i; i++) {
+                if (blockphi.getBlockID(i, j, k) >= 0) {
+                    blockActive[(size_t)i + (size_t)blockDims.i * ((size_t)j + (size_t)blockDims.j * (size_t)k)] = 1;
+                }
+            }
+        }
+    }
+
+    // The values _computeGridCountDataThread and _advectionFLIPProducerThread use
+    float eps = 1e-6;
+    vmath::vec3 offset = _getDirectionOffset(dir);
+    HKGPU::P2GInput in;
+    in.points = (const float *)_points.data();
+    in.velocities = (const float *)_velocities.data();
+    in.component = component;
+    in.numParticles = (int)_points.size();
+    in.offset[0] = offset.x;
+    in.offset[1] = offset.y;
+    in.offset[2] = offset.z;
+    in.blockActive = blockActive.data();
+    in.nbi = blockDims.i;
+    in.nbj = blockDims.j;
+    in.nbk = blockDims.k;
+    in.isize = vfieldgrid->width;
+    in.jsize = vfieldgrid->height;
+    in.ksize = vfieldgrid->depth;
+    in.blockwidth = _chunkWidth;
+    in.dx = _dx;
+    in.blockdxFloat = (float)_chunkdx;
+    in.blockdxDouble = _chunkWidth * _dx;
+    in.radius = (float)_particleRadius;
+    in.searchRadius = (float)(_particleRadius + eps);
+    in.eps = eps;
+
+    int n = vfieldgrid->getNumElements();
+    std::vector<float> field(n);
+    std::vector<unsigned char> valid(n);
+    bool gpuDone = HKGPU::particleToGrid(in, field.data(), valid.data());
+    gpuTimer.stop();
+    if (!gpuDone) {
+        return false;
+    }
+
+    float *values = vfieldgrid->getRawArray();
+    if (HKGPU::isVerifyEnabled()) {
+        // Same sums in a different order: count faces beyond float rounding
+        StopWatch cpuTimer;
+        cpuTimer.start();
+        _advectGridCPU(dir);
+        cpuTimer.stop();
+        HKGPU::addVerifyTiming(HKGPU::STEP_ADVECTION, gpuTimer.getTime(), cpuTimer.getTime());
+        long long mismatches = 0;
+        double maxDiff = 0.0;
+        for (int i = 0; i < n; i++) {
+            double difference = std::abs((double)values[i] - (double)field[i]);
+            maxDiff = std::max(maxDiff, difference);
+            bool cpuValid = validgrid->getRawArray()[i];
+            if (cpuValid != (valid[i] != 0) ||
+                    difference > 1e-5 * (1.0 + std::abs((double)values[i]))) {
+                mismatches++;
+            }
+        }
+        HKGPU::addVerifyResult(HKGPU::STEP_ADVECTION, mismatches, n);
+        HKGPU::addVerifyMaxDiff(HKGPU::STEP_ADVECTION, maxDiff);
+        return true;
+    }
+
+    std::memcpy(values, field.data(), (size_t)n * sizeof(float));
+    bool *validValues = validgrid->getRawArray();
+    for (int i = 0; i < n; i++) {
+        if (valid[i]) {
+            validValues[i] = true;
+        }
+    }
+    return true;
+}
