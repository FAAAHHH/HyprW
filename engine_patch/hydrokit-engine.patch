+bool ParticleLevelSet::_computeSignedDistanceGPU(std::vector<vmath::vec3> &particles, double radius,
+                                                 BlockArray3d<float> &blockphi, std::vector<float> &field) {
+    static_assert(sizeof(vmath::vec3) == 3 * sizeof(float), "vec3 must be three packed floats");
+
+    BlockArray3dParameters blockParams;
+    blockParams.isize = _isize;
+    blockParams.jsize = _jsize;
+    blockParams.ksize = _ksize;
+    blockParams.blockwidth = _blockwidth;
+    Dims3d blockDims = BlockArray3d<float>::getBlockDimensions(blockParams);
+
+    std::vector<unsigned char> blockActive((size_t)blockDims.i * blockDims.j * blockDims.k, 0);
+    for (int k = 0; k < blockDims.k; k++) {
+        for (int j = 0; j < blockDims.j; j++) {
+            for (int i = 0; i < blockDims.i; i++) {
+                if (blockphi.getBlockID(i, j, k) >= 0) {
+                    blockActive[(size_t)i + (size_t)blockDims.i * ((size_t)j + (size_t)blockDims.j * (size_t)k)] = 1;
+                }
+            }
+        }
+    }
+
+    // The values _computeGridCountDataThread and _computeExactBandProducerThread use
+    HKGPU::MesherFieldInput in;
+    in.particles = (const float *)particles.data();
+    in.numParticles = (int)particles.size();
+    in.blockActive = blockActive.data();
+    in.nbi = blockDims.i;
+    in.nbj = blockDims.j;
+    in.nbk = blockDims.k;
+    in.isize = _isize;
+    in.jsize = _jsize;
+    in.ksize = _ksize;
+    in.blockwidth = _blockwidth;
+    in.subdx = _dx;
+    in.blockdxFloat = (float)(_blockwidth * _dx);
+    in.blockdxDouble = _blockwidth * _dx;
+    in.radius = (float)radius;
+    in.searchRadius = _searchRadiusFactor * in.radius;
+    in.maxDistance = _getMaxDistance();
+    in.halfOffset = 0.5 * _dx;      // GridIndexToCellCenter: hw = 0.5 * dx
+    in.boxPlusOne = 0;
+
+    return HKGPU::computeMesherScalarField(in, field, HKGPU::STEP_WATER);
+}
