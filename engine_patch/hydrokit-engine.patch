+extern "C" __global__ void hk_mc_count(const float *values, const unsigned char *solid,
+        int ni, int nj, int nk, double threshold, int *cellVerts, int *cellTris) {
+    int ci = ni - 1, cj = nj - 1, ck = nk - 1;
+    size_t numCells = (size_t)ci * (size_t)cj * (size_t)ck;
+    size_t c = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= numCells) {
+        return;
+    }
+    int i = (int)(c % (size_t)ci);
+    int j = (int)((c / (size_t)ci) % (size_t)cj);
+    int k = (int)(c / ((size_t)ci * (size_t)cj));
+    int cube = hk_mc_cube(values, solid, ni, nj, i, j, k, threshold);
+    int edges = hk_mc_edges[cube];
+    int nv = 0, nt = 0;
+    if (edges != 0) {
+        for (int e = 0; e < 12; e++) {
+            if ((edges & (1 << e)) && hk_mc_creates(e, i, j, k)) {
+                nv++;
+            }
+        }
+        for (int t = 0; t < 16 && hk_mc_tris[cube][t] != -1; t += 3) {
+            nt++;
+        }
+    }
+    cellVerts[c] = nv;
+    cellTris[c] = nt;
+}
+
+// Exclusive prefix sum within blocks of 1024 (in place allowed); the sum of
+// each block goes to blockSums
+extern "C" __global__ void hk_scan_block(const int *in, int *out, int n, int *blockSums) {
+    __shared__ int s[1024];
+    int t = threadIdx.x;
+    size_t g = (size_t)blockIdx.x * 1024 + t;
+    int v = g < (size_t)n ? in[g] : 0;
+    s[t] = v;
+    __syncthreads();
+    for (int off = 1; off < 1024; off <<= 1) {
+        int a = t >= off ? s[t - off] : 0;
+        __syncthreads();
+        s[t] += a;
+        __syncthreads();
+    }
+    if (g < (size_t)n) {
+        out[g] = s[t] - v;
+    }
+    if (t == 1023) {
+        blockSums[blockIdx.x] = s[t];
+    }
+}
+
+extern "C" __global__ void hk_scan_add(int *data, int n, const int *blockOffsets) {
+    size_t g = (size_t)blockIdx.x * 1024 + threadIdx.x;
+    if (g < (size_t)n) {
+        data[g] += blockOffsets[blockIdx.x];
+    }
+}
+
+extern "C" __global__ void hk_mc_vertices(const float *values, const unsigned char *solid,
+        int ni, int nj, int nk, double threshold, double dx,
+        int hasSolid, const float *phi, int si, int sj, int sk, double sdx,
+        float ox, float oy, float oz,
+        const int *vertBase, float *vertices) {
+    int ci = ni - 1, cj = nj - 1, ck = nk - 1;
+    size_t numCells = (size_t)ci * (size_t)cj * (size_t)ck;
+    size_t c = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= numCells) {
+        return;
+    }
+    int i = (int)(c % (size_t)ci);
+    int j = (int)((c / (size_t)ci) % (size_t)cj);
+    int k = (int)(c / ((size_t)ci * (size_t)cj));
+    int cube = hk_mc_cube(values, solid, ni, nj, i, j, k, threshold);
+    int edges = hk_mc_edges[cube];
+    if (edges == 0) {
+        return;
+    }
+    // Polygonizer3d::_getVertexPosition: (float)dx * (float)index
+    float dxf = (float)dx;
+    int r = vertBase[c];
+    for (int e = 0; e < 12; e++) {
+        if (!(edges & (1 << e)) || !hk_mc_creates(e, i, j, k)) {
+            continue;
+        }
+        int ca = hk_mc_ea[e], cb = hk_mc_eb[e];
+        int ai = i + hk_mc_ci[ca], aj = j + hk_mc_cj[ca], ak = k + hk_mc_ck[ca];
+        int bi = i + hk_mc_ci[cb], bj = j + hk_mc_cj[cb], bk = k + hk_mc_ck[cb];
+        float p1x = dxf * (float)ai, p1y = dxf * (float)aj, p1z = dxf * (float)ak;
+        float p2x = dxf * (float)bi, p2y = dxf * (float)bj, p2z = dxf * (float)bk;
+        double v1 = hk_mc_value(values, solid, hk_mc_node(ni, nj, ai, aj, ak), threshold);
+        double v2 = hk_mc_value(values, solid, hk_mc_node(ni, nj, bi, bj, bk), threshold);
+
+        // Polygonizer3d::_vertexInterp
+        double minmu = 0.0;
+        double maxmu = 1.0;
+        double eps = 1e-10;
+        if (hasSolid) {
+            double s1 = (double)hk_mc_solid_phi(phi, si, sj, sk, sdx, p1x + ox, p1y + oy, p1z + oz);
+            double s2 = (double)hk_mc_solid_phi(phi, si, sj, sk, sdx, p2x + ox, p2y + oy, p2z + oz);
+            if ((s1 < 0.0 && s2 >= 0.0) || (s2 < 0.0 && s1 >= 0.0)) {
+                double diff = s2 - s1;
+                if (fabs(diff) > eps) {
+                    double su = -s1 / diff;
+                    if (s1 < 0.0) {
+                        minmu = su;
+                    } else {
+                        maxmu = su;
+                    }
+                } else {
+                    maxmu = minmu;
+                }
+            }
+        }
+        minmu = fmax(minmu, eps);
+        maxmu = fmin(maxmu, 1.0 - eps);
+        double mu = (threshold - v1) / (v2 - v1);
+        if (mu < minmu) {
+            mu = minmu;
+        }
+        if (mu > maxmu) {
+            mu = maxmu;
+        }
+        float m = (float)mu;
+        size_t o = 3 * (size_t)r;
+        vertices[o] = p1x + m * (p2x - p1x);
+        vertices[o + 1] = p1y + m * (p2y - p1y);
+        vertices[o + 2] = p1z + m * (p2z - p1z);
+        r++;
+    }
+}
+
+extern "C" __global__ void hk_mc_triangles(const float *values, const unsigned char *solid,
+        int ni, int nj, int nk, double threshold,
+        const int *vertBase, const int *triBase, int *triangles) {
+    int ci = ni - 1, cj = nj - 1, ck = nk - 1;
+    size_t numCells = (size_t)ci * (size_t)cj * (size_t)ck;
+    size_t c = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= numCells) {
+        return;
+    }
+    int i = (int)(c % (size_t)ci);
+    int j = (int)((c / (size_t)ci) % (size_t)cj);
+    int k = (int)(c / ((size_t)ci * (size_t)cj));
+    int cube = hk_mc_cube(values, solid, ni, nj, i, j, k, threshold);
+    int edges = hk_mc_edges[cube];
+    if (edges == 0) {
+        return;
+    }
+    int vertexList[12];
+    for (int e = 0; e < 12; e++) {
+        if (!(edges & (1 << e))) {
+            continue;
+        }
+        int x, y, z, ee;
+        hk_mc_creator(e, i, j, k, ci, cj, ck, x, y, z, ee);
+        int creatorCube = (x == i && y == j && z == k) ? cube
+                        : hk_mc_cube(values, solid, ni, nj, x, y, z, threshold);
+        int creatorEdges = hk_mc_edges[creatorCube];
+        int rank = 0;
+        for (int f = 0; f < ee; f++) {
+            if ((creatorEdges & (1 << f)) && hk_mc_creates(f, x, y, z)) {
+                rank++;
+            }
+        }
+        size_t creator = (size_t)x + (size_t)ci * ((size_t)y + (size_t)cj * (size_t)z);
+        vertexList[e] = vertBase[creator] + rank;
+    }
+    int t0 = triBase[c];
+    for (int t = 0; t < 16 && hk_mc_tris[cube][t] != -1; t += 3) {
+        size_t o = 3 * ((size_t)t0 + (size_t)(t / 3));
+        triangles[o] = vertexList[hk_mc_tris[cube][t]];
+        triangles[o + 1] = vertexList[hk_mc_tris[cube][t + 1]];
+        triangles[o + 2] = vertexList[hk_mc_tris[cube][t + 2]];
+    }
+}
