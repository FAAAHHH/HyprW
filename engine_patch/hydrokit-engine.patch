@@ -0,0 +1,55 @@
+/*
+HydroKit: the water surface from anisotropic kernels (Yu & Turk, "Reconstructing
+Surfaces of Particle-Based Fluids Using Anisotropic Kernels", SCA 2010 / ACM TOG
+32(1) 2013). Measured against the engine's union of spheres in the prototype
+~/hk_testlauf/netz/proto/proto.py (variant v6, 20.11.2026): the spheres add 19 %
+to the water (+52 % on a test block) and look like gel; the paper's kernels alone
+lose 23-30 % and break a pool into "crushed ice". This class adds what fixed it:
+a light Gaussian smoothing of the field and a surface threshold chosen so the
+mesh holds exactly the particles' volume (dx^3 / 8 each) — the threshold itself
+is found by ParticleMesher over all compute chunks.
+*/
+
+#ifndef HKANISO_H
+#define HKANISO_H
+
+#include <vector>
+
+#include "vmath.h"
+
+class HKAniso {
+public:
+    struct Parameters {
+        double dx = 0.0;           // simulation cell size
+        double kernelRadius = 1.2; // kernel radius h, in dx (prototype v4/v6)
+        double lambda = 0.5;       // shift of each kernel towards its neighbours' mean
+        double blur = 0.5;         // Gaussian smoothing of the field, sigma in dx
+    };
+
+    void prepare(std::vector<vmath::vec3> *particles, Parameters params);
+
+    // How far beyond a particle its smoothed field can reach (world units)
+    double getReach() { return _reach; }
+    size_t size() { return _centres.size(); }
+
+    // The smoothed field on isize x jsize x ksize nodes spaced nodedx apart,
+    // node (0, 0, 0) at offset; inside the water it is about 1, outside 0
+    void computeField(vmath::vec3 offset, int isize, int jsize, int ksize,
+                      double nodedx, std::vector<float> &field);
+
+private:
+    void _splatSlab(vmath::vec3 offset, int pi, int pj, int k0, int k1, double nodedx,
+                    std::vector<int> *candidates, std::vector<float> *field);
+    void _blurAxis(std::vector<float> &src, std::vector<float> &dst,
+                   int pi, int pj, int pk, int axis, std::vector<float> &weights);
+
+    Parameters _params;
+    std::vector<vmath::vec3> _centres;  // kernel centres (shifted)
+    std::vector<float> _G;              // 6 per particle: G00 G01 G02 G11 G12 G22
+    std::vector<float> _weights;        // normalisation x particle volume
+    std::vector<float> _reaches;        // kernel support radius per particle
+    double _reach = 0.0;
+    double _h = 0.0;
+};
+
+#endif
