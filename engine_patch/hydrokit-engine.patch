+void DiffuseParticleSimulation::_buildDiameterTable(std::vector<double> &table, double d50,
+                                                    double dmin, double dmax) {
+    table.clear();
+    if (d50 <= 0.0) {
+        return;
+    }
+    // Gamma(a = 2, b = 0.5 d50): F(x) = 1 - e^-x (1 + x), x = d/b.
+    // Per ID the quantile (id + 0.5)/256 — so the distribution is reproduced
+    // exactly and every particle keeps its size for its whole life.
+    double b = 0.5 * d50;
+    int n = _diffuseParticleIDLimit;
+    table.resize(n);
+    for (int id = 0; id < n; id++) {
+        double u = ((double)id + 0.5) / (double)n;
+        double lo = 0.0, hi = 50.0;
+        for (int it = 0; it < 60; it++) {
+            double x = 0.5 * (lo + hi);
+            double F = 1.0 - std::exp(-x) * (1.0 + x);
+            if (F < u) { lo = x; } else { hi = x; }
+        }
+        double d = 0.5 * (lo + hi) * b;
+        table[id] = std::min(std::max(d, dmin), dmax);
+    }
+}
