+// HydroKit: Polygonizer3d on the GPU (hk_mc_* kernels), the same vertices and
+// triangles in the same order. In verify mode the CPU polygonizes as well and
+// both meshes are compared bit for bit; the CPU's mesh is kept then.
+bool ParticleMesher::_polygonizeGPU(ScalarField &field, MeshLevelSet *solidSDF, TriangleMesh &mesh) {
+    static_assert(sizeof(vmath::vec3) == 3 * sizeof(float), "vec3 must be three packed floats");
+    static_assert(sizeof(Triangle) == 3 * sizeof(int), "Triangle must be three packed ints");
+    static_assert(sizeof(bool) == 1, "bool must be one byte");
+    if (!_useGPU) {
+        return false;
+    }
+
+    Array3d<float> *values = field.getPointerToScalarField();
+    HKGPU::PolygonizeInput in;
+    in.values = values->getRawArray();
+    in.solidVertex = (const unsigned char *)field.getPointerToIsVertexSolid()->getRawArray();
+    in.ni = values->width;
+    in.nj = values->height;
+    in.nk = values->depth;
+    in.dx = field.getCellSize();
+    in.threshold = field.getSurfaceThreshold();
+    if (solidSDF != nullptr) {
+        Array3d<float> *phi = solidSDF->getPhiArray3d();
+        in.hasSolidSDF = true;
+        in.solidPhi = phi->getRawArray();
+        in.si = phi->width;
+        in.sj = phi->height;
+        in.sk = phi->depth;
+        in.solidDx = solidSDF->getCellSize();
+        vmath::vec3 offset = field.getOffset();
+        in.offset[0] = offset.x;
+        in.offset[1] = offset.y;
+        in.offset[2] = offset.z;
+    }
+
+    // The GPU time covers the whole GPU path, the copy into the mesh included
+    std::vector<float> vertices;
+    std::vector<int> triangles;
+    StopWatch gpuTimer;
+    gpuTimer.start();
+    bool ok = HKGPU::polygonizeSurface(in, vertices, triangles, HKGPU::STEP_MESH);
+    if (!ok) {
+        return false;
+    }
+    mesh = TriangleMesh();
+    mesh.vertices.resize(vertices.size() / 3);
+    mesh.triangles.resize(triangles.size() / 3);
+    if (!vertices.empty()) {
+        std::memcpy((void *)mesh.vertices.data(), vertices.data(), vertices.size() * sizeof(float));
+    }
+    if (!triangles.empty()) {
+        std::memcpy((void *)mesh.triangles.data(), triangles.data(), triangles.size() * sizeof(int));
+    }
+    gpuTimer.stop();
+
+    if (HKGPU::isVerifyEnabled()) {
+        StopWatch cpuTimer;
+        cpuTimer.start();
+        TriangleMesh cpu;
+        if (solidSDF != nullptr) {
+            Polygonizer3d polygonizer(&field, solidSDF);
+            cpu = polygonizer.polygonizeSurface();
+        } else {
+            Polygonizer3d polygonizer(&field);
+            cpu = polygonizer.polygonizeSurface();
+        }
+        cpuTimer.stop();
+        HKGPU::addVerifyTiming(HKGPU::STEP_MESH, gpuTimer.getTime(), cpuTimer.getTime());
+        // One unit for compared and mismatches: every coordinate, every index
+        long long mismatches = 0;
+        long long compared = 3 * (long long)std::max(cpu.vertices.size(), mesh.vertices.size()) +
+                             3 * (long long)std::max(cpu.triangles.size(), mesh.triangles.size());
+        size_t nv = std::min(cpu.vertices.size(), mesh.vertices.size());
+        size_t nt = std::min(cpu.triangles.size(), mesh.triangles.size());
+        mismatches += 3 * (long long)(std::max(cpu.vertices.size(), mesh.vertices.size()) - nv);
+        mismatches += 3 * (long long)(std::max(cpu.triangles.size(), mesh.triangles.size()) - nt);
+        const float *cv = (const float *)cpu.vertices.data();
+        const float *gv = (const float *)mesh.vertices.data();
+        for (size_t c = 0; c < 3 * nv; c++) {
+            if (std::memcmp(&cv[c], &gv[c], sizeof(float)) != 0) {
+                mismatches++;
+            }
+        }
+        const int *ct = (const int *)cpu.triangles.data();
+        const int *gt = (const int *)mesh.triangles.data();
+        for (size_t c = 0; c < 3 * nt; c++) {
+            if (ct[c] != gt[c]) {
+                mismatches++;
+            }
+        }
+        HKGPU::addVerifyResult(HKGPU::STEP_MESH, mismatches, compared);
+        mesh = cpu;
+    }
+    return true;
+}
+
+// HydroKit: the GPU's preview values (hk_mesher_preview_resample) into the
+// preview field. In verify mode the real merge runs on a copy (timed as GPU
+// work), the CPU samples into the preview field itself, and every preview
+// node of both is compared bit for bit.
+void ParticleMesher::_addGPUPreviewField(ScalarFieldData &fieldData) {
+    if (HKGPU::isVerifyEnabled()) {
+        ScalarField merged = _pfield;
+        StopWatch gpuTimer;
+        gpuTimer.start();
+        _mergeGPUPreviewValues(merged);
+        gpuTimer.stop();
+        StopWatch cpuTimer;
+        cpuTimer.start();
+        _addComputeChunkScalarFieldToPreviewField(fieldData);
+        cpuTimer.stop();
+        Array3d<float> *gpu = merged.getPointerToScalarField();
+        Array3d<float> *cpu = _pfield.getPointerToScalarField();
+        const float *g = gpu->getRawArray();
+        const float *c = cpu->getRawArray();
+        size_t n = gpu->getNumElements();
+        long long mismatches = 0;
+        for (size_t idx = 0; idx < n; idx++) {
+            if (std::memcmp(&g[idx], &c[idx], sizeof(float)) != 0) {
+                mismatches++;
+            }
+        }
+        HKGPU::addVerifyResult(HKGPU::STEP_MESH, mismatches, (long long)n);
+        HKGPU::addVerifyTiming(HKGPU::STEP_MESH, gpuTimer.getTime(), cpuTimer.getTime());
+        return;
+    }
+    _mergeGPUPreviewValues(_pfield);
+}
