+    in.points = (const float *)_points.data();
+    in.velocities = (const float *)_velocities.data();
+    in.component = component;
+    in.numParticles = (int)_points.size();
+    in.offset[0] = offset.x;
+    in.offset[1] = offset.y;
+    in.offset[2] = offset.z;
+    in.blockActive = blockActive.data();
+    in.nbi = blockDims.i;
+    in.nbj = blockDims.j;
+    in.nbk = blockDims.k;
+    in.isize = vfieldgrid->width;
+    in.jsize = vfieldgrid->height;
+    in.ksize = vfieldgrid->depth;
+    in.blockwidth = _chunkWidth;
+    in.dx = _dx;
+    in.blockdxFloat = (float)_chunkdx;
+    in.blockdxDouble = _chunkWidth * _dx;
+    in.radius = (float)_particleRadius;
+    in.searchRadius = (float)(_particleRadius + eps);
+    in.eps = eps;
+
+    int n = vfieldgrid->getNumElements();
+    std::vector<float> field(n);
+    std::vector<unsigned char> valid(n);
+    bool gpuDone = HKGPU::particleToGrid(in, field.data(), valid.data());
+    gpuTimer.stop();
+    if (!gpuDone) {
+        return false;
+    }
+
+    float *values = vfieldgrid->getRawArray();
+    if (HKGPU::isVerifyEnabled()) {
+        // Same sums in a different order: count faces beyond float rounding
+        StopWatch cpuTimer;
+        cpuTimer.start();
+        _advectGridCPU(dir);
+        cpuTimer.stop();
+        HKGPU::addVerifyTiming(HKGPU::STEP_ADVECTION, gpuTimer.getTime(), cpuTimer.getTime());
+        long long mismatches = 0;
+        double maxDiff = 0.0;
+        for (int i = 0; i < n; i++) {
+            double difference = std::abs((double)values[i] - (double)field[i]);
+            maxDiff = std::max(maxDiff, difference);
+            bool cpuValid = validgrid->getRawArray()[i];
+            if (cpuValid != (valid[i] != 0) ||
+                    difference > 1e-5 * (1.0 + std::abs((double)values[i]))) {
+                mismatches++;
