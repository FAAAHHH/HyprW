+// Corner c of a cell at (i + ci, j + cj, k + ck): Grid3d::getGridIndexVertices
+__constant__ int hk_mc_ci[8] = {0, 1, 1, 0, 0, 1, 1, 0};
+__constant__ int hk_mc_cj[8] = {0, 0, 0, 0, 1, 1, 1, 1};
+__constant__ int hk_mc_ck[8] = {0, 0, 1, 1, 0, 0, 1, 1};
+// The corners of edge e, in the direction _calculateVertexList interpolates
+__constant__ int hk_mc_ea[12] = {0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3};
+__constant__ int hk_mc_eb[12] = {1, 2, 3, 0, 5, 6, 7, 4, 4, 5, 6, 7};
+
+__device__ __forceinline__ size_t hk_mc_node(int ni, int nj, int a, int b, int d) {
+    return (size_t)a + (size_t)ni * ((size_t)b + (size_t)nj * (size_t)d);
+}
+
+// ScalarField::getScalarFieldValue
+__device__ __forceinline__ double hk_mc_value(const float *values, const unsigned char *solid,
+                                              size_t n, double threshold) {
+    double v = (double)values[n];
+    if (solid[n] && v > threshold) {
+        v = threshold;
+    }
+    return v;
+}
+
+// Polygonizer3d::_calculateCubeIndex
+__device__ int hk_mc_cube(const float *values, const unsigned char *solid, int ni, int nj,
+                          int i, int j, int k, double threshold) {
+    int cube = 0;
+    for (int c = 0; c < 8; c++) {
+        size_t n = hk_mc_node(ni, nj, i + hk_mc_ci[c], j + hk_mc_cj[c], k + hk_mc_ck[c]);
+        if (hk_mc_value(values, solid, n, threshold) > threshold) {
+            cube |= 1 << c;
+        }
+    }
+    return cube;
+}
