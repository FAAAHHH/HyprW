+namespace {
+
+// The few driver API types and functions used, declared here so that
+// building needs no cuda.h (names and signatures as in the CUDA driver API).
+typedef int CUresult;
+typedef int CUdevice;
+typedef struct CUctx_st *CUcontext;
+typedef struct CUmod_st *CUmodule;
+typedef struct CUfunc_st *CUfunction;
+typedef struct CUstream_st *CUstream;
+typedef unsigned long long CUdeviceptr;
+
+const CUresult CUDA_SUCCESS = 0;
+const int ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR = 75;
+const int ATTRIBUTE_COMPUTE_CAPABILITY_MINOR = 76;
+
+struct Driver {
+    CUresult (*cuInit)(unsigned int) = nullptr;
+    CUresult (*cuDeviceGetCount)(int *) = nullptr;
+    CUresult (*cuDeviceGet)(CUdevice *, int) = nullptr;
+    CUresult (*cuDeviceGetName)(char *, int, CUdevice) = nullptr;
+    CUresult (*cuDeviceGetAttribute)(int *, int, CUdevice) = nullptr;
+    CUresult (*cuDeviceTotalMem)(size_t *, CUdevice) = nullptr;
+    CUresult (*cuDevicePrimaryCtxRetain)(CUcontext *, CUdevice) = nullptr;
+    CUresult (*cuDevicePrimaryCtxRelease)(CUdevice) = nullptr;
+    CUresult (*cuCtxPushCurrent)(CUcontext) = nullptr;
+    CUresult (*cuCtxPopCurrent)(CUcontext *) = nullptr;
+    CUresult (*cuCtxSynchronize)(void) = nullptr;
+    CUresult (*cuModuleLoadData)(CUmodule *, const void *) = nullptr;
+    CUresult (*cuModuleUnload)(CUmodule) = nullptr;
+    CUresult (*cuModuleGetFunction)(CUfunction *, CUmodule, const char *) = nullptr;
+    CUresult (*cuMemAlloc)(CUdeviceptr *, size_t) = nullptr;
+    CUresult (*cuMemFree)(CUdeviceptr) = nullptr;
+    CUresult (*cuMemcpyHtoD)(CUdeviceptr, const void *, size_t) = nullptr;
+    CUresult (*cuMemcpyDtoH)(void *, CUdeviceptr, size_t) = nullptr;
+    CUresult (*cuMemsetD32)(CUdeviceptr, unsigned int, size_t) = nullptr;
+    CUresult (*cuLaunchKernel)(CUfunction, unsigned int, unsigned int, unsigned int,
+                               unsigned int, unsigned int, unsigned int,
+                               unsigned int, CUstream, void **, void **) = nullptr;
+    CUresult (*cuGetErrorString)(CUresult, const char **) = nullptr;
+};
+
+// A device buffer that only grows
+struct Buffer {
+    CUdeviceptr ptr = 0;
+    size_t capacity = 0;
+};
+
+struct State {
+    std::mutex mutex;
+
+    bool probed = false;
+    bool available = false;
+    void *library = nullptr;
+    Driver cu;
+    CUdevice device = 0;
+    std::string deviceName;
+    size_t deviceMemory = 0;
+    std::string status;
+
+    CUcontext context = nullptr;
+    CUmodule module = nullptr;
+    CUfunction mesherField = nullptr;
+    CUfunction reinitStep = nullptr;
+    CUfunction p2gScatter = nullptr;
+    CUfunction p2gFinish = nullptr;
+    CUfunction pcgSpmv = nullptr, pcgAxpy = nullptr, pcgCopy = nullptr, pcgDot = nullptr,
+               pcgAbsmax = nullptr, pcgLower = nullptr, pcgUpper = nullptr;
+    Buffer particles, blockActive, field;
+    Buffer reinitA, reinitB, reinitCells, reinitMax;
+    Buffer p2gPoints, p2gVelocities, p2gSums, p2gField, p2gValid;
+    Buffer pcgRowstart, pcgColindex, pcgValue, pcgInvdiag, pcgColstart, pcgRowindex, pcgFactorValue,
+           pcgLowStart, pcgLowCol, pcgLowValue, pcgLevelStartL, pcgLevelRowsL, pcgLevelStartU,
+           pcgLevelRowsU, pcgR, pcgZ, pcgS, pcgX, pcgPartials;
+
+    bool verify = false;
+};
+
+State &state() {
+    static State s;
+    return s;
+}
+
+std::atomic<int> gpuCount[NUM_STEPS];
+std::atomic<int> fallbackCount[NUM_STEPS];
+std::atomic<long long> verifyMismatches[NUM_STEPS];
+std::atomic<long long> verifyCompared[NUM_STEPS];
+double verifyMaxDiff[NUM_STEPS];        // under State::mutex
+double verifyGPUTime[NUM_STEPS];        // under State::mutex
+double verifyCPUTime[NUM_STEPS];        // under State::mutex
+
+bool validStep(int step) {
+    return step >= 0 && step < NUM_STEPS;
+}
+
+void *openLibrary() {
+#ifdef _WIN32
+    return (void *)LoadLibraryA("nvcuda.dll");
+#else
+    void *lib = dlopen("libcuda.so.1", RTLD_NOW | RTLD_LOCAL);
+    if (lib == nullptr) {
+        lib = dlopen("libcuda.so", RTLD_NOW | RTLD_LOCAL);
+    }
+    return lib;
+#endif
+}
+
+void *findSymbol(void *lib, const char *name) {
+#ifdef _WIN32
+    return (void *)GetProcAddress((HMODULE)lib, name);
+#else
+    return dlsym(lib, name);
+#endif
+}
+
+template<typename T>
+bool load(void *lib, T &function, const char *name) {
+    function = (T)findSymbol(lib, name);
+    return function != nullptr;
+}
+
+std::string errorText(State &s, CUresult result, const char *what) {
+    const char *text = nullptr;
+    if (s.cu.cuGetErrorString != nullptr) {
+        s.cu.cuGetErrorString(result, &text);
+    }
+    return std::string(what) + ": " + (text != nullptr ? text : "CUDA error " + std::to_string(result));
+}
+
+// With the mutex held
+void probe(State &s) {
+    if (s.probed) {
+        return;
+    }
+    s.probed = true;
+
+#if defined(__APPLE__)
+    s.status = "No CUDA on macOS";
+    return;
+#endif
+
+    s.library = openLibrary();
+    if (s.library == nullptr) {
+        s.status = "No NVIDIA driver with CUDA found";
+        return;
+    }
+
+    Driver &cu = s.cu;
+    // The _v2 entry points are the ones cuda.h maps the plain names to
+    bool ok = load(s.library, cu.cuInit, "cuInit") &&
+              load(s.library, cu.cuDeviceGetCount, "cuDeviceGetCount") &&
+              load(s.library, cu.cuDeviceGet, "cuDeviceGet") &&
+              load(s.library, cu.cuDeviceGetName, "cuDeviceGetName") &&
+              load(s.library, cu.cuDeviceGetAttribute, "cuDeviceGetAttribute") &&
+              load(s.library, cu.cuDeviceTotalMem, "cuDeviceTotalMem_v2") &&
+              load(s.library, cu.cuDevicePrimaryCtxRetain, "cuDevicePrimaryCtxRetain") &&
+              load(s.library, cu.cuDevicePrimaryCtxRelease, "cuDevicePrimaryCtxRelease_v2") &&
+              load(s.library, cu.cuCtxPushCurrent, "cuCtxPushCurrent_v2") &&
+              load(s.library, cu.cuCtxPopCurrent, "cuCtxPopCurrent_v2") &&
+              load(s.library, cu.cuCtxSynchronize, "cuCtxSynchronize") &&
+              load(s.library, cu.cuModuleLoadData, "cuModuleLoadData") &&
+              load(s.library, cu.cuModuleUnload, "cuModuleUnload") &&
+              load(s.library, cu.cuModuleGetFunction, "cuModuleGetFunction") &&
+              load(s.library, cu.cuMemAlloc, "cuMemAlloc_v2") &&
+              load(s.library, cu.cuMemFree, "cuMemFree_v2") &&
+              load(s.library, cu.cuMemcpyHtoD, "cuMemcpyHtoD_v2") &&
+              load(s.library, cu.cuMemcpyDtoH, "cuMemcpyDtoH_v2") &&
+              load(s.library, cu.cuMemsetD32, "cuMemsetD32_v2") &&
+              load(s.library, cu.cuLaunchKernel, "cuLaunchKernel") &&
+              load(s.library, cu.cuGetErrorString, "cuGetErrorString");
+    if (!ok) {
+        s.status = "The NVIDIA driver is too old (missing CUDA functions)";
+        return;
+    }
+
+    CUresult r = cu.cuInit(0);
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, "CUDA could not start");
+        return;
+    }
+    int count = 0;
+    r = cu.cuDeviceGetCount(&count);
+    if (r != CUDA_SUCCESS || count < 1) {
+        s.status = "No CUDA device found";
+        return;
+    }
+    r = cu.cuDeviceGet(&s.device, 0);
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, "CUDA device 0");
+        return;
+    }
+
+    char name[256] = {0};
+    cu.cuDeviceGetName(name, (int)sizeof(name) - 1, s.device);
+    s.deviceName = name;
+    cu.cuDeviceTotalMem(&s.deviceMemory, s.device);
+
+    int major = 0, minor = 0;
+    cu.cuDeviceGetAttribute(&major, ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR, s.device);
+    cu.cuDeviceGetAttribute(&minor, ATTRIBUTE_COMPUTE_CAPABILITY_MINOR, s.device);
+    if (major * 10 + minor < 75) {
+        s.status = s.deviceName + " is too old (compute capability " +
+                   std::to_string(major) + "." + std::to_string(minor) + ", needs 7.5)";
+        return;
+    }
+
+    s.available = true;
+    s.status = "";
+}
+
+// With the mutex held; frees everything but keeps the probe result
+void releaseLocked(State &s) {
+    if (s.context != nullptr) {
+        s.cu.cuCtxPushCurrent(s.context);
+        Buffer *buffers[] = {&s.particles, &s.blockActive, &s.field,
+                             &s.reinitA, &s.reinitB, &s.reinitCells, &s.reinitMax,
+                             &s.p2gPoints, &s.p2gVelocities, &s.p2gSums, &s.p2gField, &s.p2gValid,
+                             &s.pcgRowstart, &s.pcgColindex, &s.pcgValue, &s.pcgInvdiag, &s.pcgColstart,
+                             &s.pcgRowindex, &s.pcgFactorValue, &s.pcgLowStart, &s.pcgLowCol, &s.pcgLowValue,
+                             &s.pcgLevelStartL, &s.pcgLevelRowsL, &s.pcgLevelStartU, &s.pcgLevelRowsU,
+                             &s.pcgR, &s.pcgZ, &s.pcgS, &s.pcgX, &s.pcgPartials};
+        for (Buffer *b : buffers) {
+            if (b->ptr != 0) {
+                s.cu.cuMemFree(b->ptr);
+            }
+            b->ptr = 0;
+            b->capacity = 0;
+        }
+        if (s.module != nullptr) {
+            s.cu.cuModuleUnload(s.module);
+        }
+        CUcontext previous;
+        s.cu.cuCtxPopCurrent(&previous);
+        s.cu.cuDevicePrimaryCtxRelease(s.device);
+    }
+    s.module = nullptr;
+    s.mesherField = nullptr;
+    s.reinitStep = nullptr;
+    s.p2gScatter = nullptr;
+    s.p2gFinish = nullptr;
+    s.pcgSpmv = s.pcgAxpy = s.pcgCopy = s.pcgDot = s.pcgAbsmax = s.pcgLower = s.pcgUpper = nullptr;
+    s.context = nullptr;
+}
+
+// With the mutex held: context and module, created on first use
+bool ensureContext(State &s) {
+    if (s.context != nullptr) {
+        return true;
+    }
+    CUresult r = s.cu.cuDevicePrimaryCtxRetain(&s.context, s.device);
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, "GPU context");
+        s.context = nullptr;
+        return false;
+    }
+    s.cu.cuCtxPushCurrent(s.context);
+    r = s.cu.cuModuleLoadData(&s.module, hkgpu_kernels_fatbin);
+    if (r == CUDA_SUCCESS) {
+        r = s.cu.cuModuleGetFunction(&s.mesherField, s.module, "hk_mesher_scalar_field");
+    }
+    if (r == CUDA_SUCCESS) {
+        r = s.cu.cuModuleGetFunction(&s.reinitStep, s.module, "hk_reinit_upwind_step");
+    }
+    if (r == CUDA_SUCCESS) {
+        r = s.cu.cuModuleGetFunction(&s.p2gScatter, s.module, "hk_p2g_scatter");
+    }
+    if (r == CUDA_SUCCESS) {
+        r = s.cu.cuModuleGetFunction(&s.p2gFinish, s.module, "hk_p2g_finish");
+    }
+    struct { CUfunction *function; const char *name; } pcg[] = {
+        {&s.pcgSpmv, "hk_pcg_spmv"}, {&s.pcgAxpy, "hk_pcg_axpy"}, {&s.pcgCopy, "hk_pcg_copy"},
+        {&s.pcgDot, "hk_pcg_dot"}, {&s.pcgAbsmax, "hk_pcg_absmax"},
+        {&s.pcgLower, "hk_pcg_lower"}, {&s.pcgUpper, "hk_pcg_upper"}};
+    for (auto &k : pcg) {
+        if (r == CUDA_SUCCESS) {
+            r = s.cu.cuModuleGetFunction(k.function, s.module, k.name);
+        }
+    }
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, "Loading the GPU kernels");
+        releaseLocked(s);
+        return false;
+    }
+    return true;
+}
+
+// With the context current
+CUresult reserve(State &s, Buffer &b, size_t bytes) {
+    if (b.capacity >= bytes) {
+        return CUDA_SUCCESS;
+    }
+    if (b.ptr != 0) {
+        s.cu.cuMemFree(b.ptr);
+        b.ptr = 0;
+        b.capacity = 0;
+    }
+    // A little headroom: particle counts grow from frame to frame
+    size_t size = bytes + bytes / 4;
+    CUresult r = s.cu.cuMemAlloc(&b.ptr, size);
+    if (r == CUDA_SUCCESS) {
+        b.capacity = size;
+    } else {
+        b.ptr = 0;
+    }
+    return r;
+}
+
+}
+
+bool isAvailable() {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    return s.available;
+}
+
+std::string getDeviceName() {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    return s.deviceName;
+}
+
+size_t getDeviceMemory() {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    return s.deviceMemory;
+}
+
+std::string getStatusMessage() {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    return s.status;
+}
+
+bool computeMesherScalarField(const MesherFieldInput &in, std::vector<float> &out, int countStep) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!validStep(countStep)) {
+        countStep = STEP_MESH;
+    }
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[countStep]++;
+        return false;
+    }
+
+    size_t numNodes = (size_t)in.isize * (size_t)in.jsize * (size_t)in.ksize;
+    size_t numBlocks = (size_t)in.nbi * (size_t)in.nbj * (size_t)in.nbk;
+    size_t particleBytes = (size_t)in.numParticles * 3 * sizeof(float);
+    out.assign(numNodes, in.maxDistance);
+    if (numNodes == 0 || in.numParticles == 0) {
+        gpuCount[countStep]++;
+        return true;
+    }
+
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    do {
+        step = "GPU memory";
+        if ((r = reserve(s, s.particles, particleBytes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.blockActive, numBlocks)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.field, numNodes * sizeof(float))) != CUDA_SUCCESS) break;
+
+        step = "Copying to the GPU";
+        if ((r = s.cu.cuMemcpyHtoD(s.particles.ptr, in.particles, particleBytes)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuMemcpyHtoD(s.blockActive.ptr, in.blockActive, numBlocks)) != CUDA_SUCCESS) break;
+        unsigned int fillBits;
+        std::memcpy(&fillBits, &in.maxDistance, sizeof(fillBits));
+        if ((r = s.cu.cuMemsetD32(s.field.ptr, fillBits, numNodes)) != CUDA_SUCCESS) break;
+
+        // Reciprocals exactly as the CPU computes them (positionToGridIndex:
+        // invdx = 1.0 / dx in double, with dx the float blockdx or _subdx)
+        double invSubdx = 1.0 / in.subdx;
+        double invBlockdxFloat = 1.0 / (double)in.blockdxFloat;
+        int numParticles = in.numParticles;
+        int nbi = in.nbi, nbj = in.nbj, nbk = in.nbk;
+        int isize = in.isize, jsize = in.jsize, ksize = in.ksize;
+        int blockwidth = in.blockwidth;
+        double subdx = in.subdx;
+        float blockdxFloat = in.blockdxFloat;
+        double blockdxDouble = in.blockdxDouble;
+        float radius = in.radius;
+        float searchRadius = in.searchRadius;
+        double halfOffset = in.halfOffset;
+        int boxPlusOne = in.boxPlusOne;
+        void *args[] = {
+            &s.particles.ptr, &numParticles,
+            &s.blockActive.ptr, &nbi, &nbj, &nbk,
+            &s.field.ptr, &isize, &jsize, &ksize,
+            &blockwidth, &subdx, &invSubdx,
+            &blockdxFloat, &invBlockdxFloat, &blockdxDouble,
+            &radius, &searchRadius, &halfOffset, &boxPlusOne
+        };
+        unsigned int threads = 128;
+        unsigned int groups = (unsigned int)((numParticles + threads - 1) / threads);
+
+        step = "Mesher kernel";
+        if ((r = s.cu.cuLaunchKernel(s.mesherField, groups, 1, 1, threads, 1, 1,
+                                     0, nullptr, args, nullptr)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuCtxSynchronize()) != CUDA_SUCCESS) break;
+
+        step = "Copying from the GPU";
+        r = s.cu.cuMemcpyDtoH(out.data(), s.field.ptr, numNodes * sizeof(float));
+    } while (false);
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        // A failed kernel can leave the context unusable: start over next time
+        releaseLocked(s);
+        fallbackCount[countStep]++;
+        return false;
+    }
+    gpuCount[countStep]++;
+    return true;
+}
+
+bool reinitializeUpwind(const ReinitInput &in, float *output) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[STEP_CURVATURE]++;
+        return false;
+    }
+
+    size_t numNodes = (size_t)in.isize * (size_t)in.jsize * (size_t)in.ksize;
+    size_t gridBytes = numNodes * sizeof(float);
+    int numCells = (int)in.cells->size();
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    do {
+        step = "GPU memory";
+        if ((r = reserve(s, s.reinitA, gridBytes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.reinitB, gridBytes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.reinitCells, (size_t)numCells * sizeof(int) + sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.reinitMax, sizeof(unsigned int))) != CUDA_SUCCESS) break;
+
+        // Both buffers start as the input — as LevelSetSolver does since
+        // HydroKit fixed its uninitialized temporary grid
+        step = "Copying to the GPU";
+        if ((r = s.cu.cuMemcpyHtoD(s.reinitA.ptr, in.inputSDF, gridBytes)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuMemcpyHtoD(s.reinitB.ptr, in.inputSDF, gridBytes)) != CUDA_SUCCESS) break;
+        if (numCells > 0 &&
+                (r = s.cu.cuMemcpyHtoD(s.reinitCells.ptr, in.cells->data(), (size_t)numCells * sizeof(int))) != CUDA_SUCCESS) break;
+
+        CUdeviceptr cur = s.reinitA.ptr;
+        CUdeviceptr next = s.reinitB.ptr;
+        int isize = in.isize, jsize = in.jsize, ksize = in.ksize;
+        float dx = in.dx, dtau = in.dtau;
+        unsigned int threads = 128;
+        unsigned int groups = (unsigned int)((numCells + threads - 1) / threads);
+
+        // The CPU loop of reinitializeUpwind, with the same convergence test
+        float lastMaxDiff = -1.0f;
+        for (int n = 0; n < in.numIterations && numCells > 0; n++) {
+            step = "Reinitialization kernel";
+            if ((r = s.cu.cuMemsetD32(s.reinitMax.ptr, 0u, 1)) != CUDA_SUCCESS) break;
+            void *args[] = {&cur, &next, &s.reinitCells.ptr, &numCells,
+                            &isize, &jsize, &ksize, &dx, &dtau, &s.reinitMax.ptr};
+            if ((r = s.cu.cuLaunchKernel(s.reinitStep, groups, 1, 1, threads, 1, 1,
+                                         0, nullptr, args, nullptr)) != CUDA_SUCCESS) break;
+            unsigned int maxBits = 0;
+            if ((r = s.cu.cuMemcpyDtoH(&maxBits, s.reinitMax.ptr, sizeof(maxBits))) != CUDA_SUCCESS) break;
+            float maxDiff;
+            std::memcpy(&maxDiff, &maxBits, sizeof(maxDiff));
+
+            std::swap(cur, next);
+            if (std::abs(maxDiff - lastMaxDiff) < in.errorThreshold) {
+                break;
+            }
+            lastMaxDiff = maxDiff;
+        }
+        if (r != CUDA_SUCCESS) break;
+
+        step = "Copying from the GPU";
+        r = s.cu.cuMemcpyDtoH(output, cur, gridBytes);
+    } while (false);
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        releaseLocked(s);
+        fallbackCount[STEP_CURVATURE]++;
+        return false;
+    }
+    gpuCount[STEP_CURVATURE]++;
+    return true;
+}
+
+bool particleToGrid(const P2GInput &in, float *field, unsigned char *valid) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[STEP_ADVECTION]++;
+        return false;
+    }
+
+    size_t numFaces = (size_t)in.isize * (size_t)in.jsize * (size_t)in.ksize;
+    size_t numBlocks = (size_t)in.nbi * (size_t)in.nbj * (size_t)in.nbk;
+    size_t vecBytes = (size_t)in.numParticles * 3 * sizeof(float);
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    do {
+        step = "GPU memory";
+        if ((r = reserve(s, s.p2gPoints, vecBytes + sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gVelocities, vecBytes + sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.blockActive, numBlocks + 1)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gSums, numFaces * 2 * sizeof(double))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gField, numFaces * sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gValid, numFaces)) != CUDA_SUCCESS) break;
+
+        step = "Copying to the GPU";
+        if (in.numParticles > 0) {
+            if ((r = s.cu.cuMemcpyHtoD(s.p2gPoints.ptr, in.points, vecBytes)) != CUDA_SUCCESS) break;
+            if ((r = s.cu.cuMemcpyHtoD(s.p2gVelocities.ptr, in.velocities, vecBytes)) != CUDA_SUCCESS) break;
+        }
+        if ((r = s.cu.cuMemcpyHtoD(s.blockActive.ptr, in.blockActive, numBlocks)) != CUDA_SUCCESS) break;
+        // 0.0 in double is all zero bits
+        if ((r = s.cu.cuMemsetD32(s.p2gSums.ptr, 0u, numFaces * 4)) != CUDA_SUCCESS) break;
+
+        int component = in.component, numParticles = in.numParticles;
+        float ox = in.offset[0], oy = in.offset[1], oz = in.offset[2];
+        int nbi = in.nbi, nbj = in.nbj, nbk = in.nbk;
+        int isize = in.isize, jsize = in.jsize, ksize = in.ksize;
+        int blockwidth = in.blockwidth;
+        double dx = in.dx, invDx = 1.0 / in.dx;
+        float blockdxFloat = in.blockdxFloat;
+        double invBlockdxFloat = 1.0 / (double)in.blockdxFloat;
+        double blockdxDouble = in.blockdxDouble;
+        // _advectionFLIPProducerThread's constants, in float as there
+        float rr = in.radius;
+        float sr = in.searchRadius;
+        float rsq = rr * rr;
+        float coef1 = (4.0f / 9.0f) * (1.0f / (rr*rr*rr*rr*rr*rr));
+        float coef2 = (17.0f / 9.0f) * (1.0f / (rr*rr*rr*rr));
+        float coef3 = (22.0f / 9.0f) * (1.0f / (rr*rr));
+        unsigned int threads = 128;
+        if (numParticles > 0) {
+            step = "Velocity transfer kernel";
+            void *args[] = {&s.p2gPoints.ptr, &s.p2gVelocities.ptr, &component, &numParticles,
+                            &ox, &oy, &oz, &s.blockActive.ptr, &nbi, &nbj, &nbk,
+                            &s.p2gSums.ptr, &isize, &jsize, &ksize,
+                            &blockwidth, &dx, &invDx, &blockdxFloat, &invBlockdxFloat, &blockdxDouble,
+                            &rr, &sr, &rsq, &coef1, &coef2, &coef3};
+            unsigned int groups = (unsigned int)((numParticles + threads - 1) / threads);
+            if ((r = s.cu.cuLaunchKernel(s.p2gScatter, groups, 1, 1, threads, 1, 1,
+                                         0, nullptr, args, nullptr)) != CUDA_SUCCESS) break;
+        }
+        int faces = (int)numFaces;
+        float eps = in.eps;
+        void *finishArgs[] = {&s.p2gSums.ptr, &faces, &eps, &s.p2gField.ptr, &s.p2gValid.ptr};
+        unsigned int groups = (unsigned int)((faces + threads - 1) / threads);
+        if ((r = s.cu.cuLaunchKernel(s.p2gFinish, groups, 1, 1, threads, 1, 1,
+                                     0, nullptr, finishArgs, nullptr)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuCtxSynchronize()) != CUDA_SUCCESS) break;
+
+        step = "Copying from the GPU";
+        if ((r = s.cu.cuMemcpyDtoH(field, s.p2gField.ptr, numFaces * sizeof(float))) != CUDA_SUCCESS) break;
+        r = s.cu.cuMemcpyDtoH(valid, s.p2gValid.ptr, numFaces);
+    } while (false);
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        releaseLocked(s);
+        fallbackCount[STEP_ADVECTION]++;
+        return false;
+    }
+    gpuCount[STEP_ADVECTION]++;
+    return true;
+}
+
+namespace {
+
+// Levels for the triangular solves: a row's level is one more than the
+// highest level it depends on, so rows of one level are independent.
+// Returned as start offsets per level and the rows sorted by level.
+void bucketByLevel(const std::vector<int> &level, int numLevels,
+                   std::vector<int> &levelStart, std::vector<int> &levelRows) {
+    levelStart.assign(numLevels + 1, 0);
+    for (int l : level) {
+        levelStart[l + 1]++;
+    }
+    for (int l = 0; l < numLevels; l++) {
+        levelStart[l + 1] += levelStart[l];
+    }
+    std::vector<int> fill(levelStart.begin(), levelStart.end() - 1);
+    levelRows.assign(level.size(), 0);
+    for (size_t r = 0; r < level.size(); r++) {
+        levelRows[fill[level[r]]++] = (int)r;
+    }
+}
+
+}
+
+bool solvePCG(const PCGInput &in, double *result, PCGResult &out) {
+    int n = in.n;
+    if (n <= 0) {
+        return false;
+    }
+    unsigned int nnz = in.rowstart[n];
+    unsigned int nnzL = in.colstart[n];
+
+    // Row form of the factor's lower part (ascending columns, as the CPU's
+    // column loop applies them) and the levels of both solves
+    std::vector<int> lowStart(n + 1, 0), lowCol(nnzL), lowerLevel(n, 0), upperLevel(n, 0);
+    std::vector<double> lowValue(nnzL);
+    for (unsigned int j = 0; j < nnzL; j++) {
+        lowStart[in.rowindex[j] + 1]++;
+    }
+    for (int i = 0; i < n; i++) {
+        lowStart[i + 1] += lowStart[i];
+    }
+    std::vector<int> fill(lowStart.begin(), lowStart.end() - 1);
+    int numLevelsL = 1;
+    for (int i = 0; i < n; i++) {
+        for (unsigned int j = in.colstart[i]; j < in.colstart[i + 1]; j++) {
+            int row = (int)in.rowindex[j];
+            lowCol[fill[row]] = i;
+            lowValue[fill[row]] = in.factorValue[j];
+            fill[row]++;
+            lowerLevel[row] = std::max(lowerLevel[row], lowerLevel[i] + 1);
+            numLevelsL = std::max(numLevelsL, lowerLevel[row] + 1);
+        }
+    }
+    int numLevelsU = 1;
+    for (int i = n - 1; i >= 0; i--) {
+        for (unsigned int j = in.colstart[i]; j < in.colstart[i + 1]; j++) {
+            upperLevel[i] = std::max(upperLevel[i], upperLevel[in.rowindex[j]] + 1);
+        }
+        numLevelsU = std::max(numLevelsU, upperLevel[i] + 1);
+    }
+    std::vector<int> levelStartL, levelRowsL, levelStartU, levelRowsU;
+    bucketByLevel(lowerLevel, numLevelsL, levelStartL, levelRowsL);
+    bucketByLevel(upperLevel, numLevelsU, levelStartU, levelRowsU);
+
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[STEP_PRESSURE]++;
+        return false;
+    }
+
+    const int partialBlocks = 64;
+    const unsigned int threads = 256;
+    size_t vecBytes = (size_t)n * sizeof(double);
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    std::vector<double> partials(partialBlocks);
+
+    // Small helpers on the current context; any error ends the solve
+    auto launch = [&](CUfunction f, unsigned int groups, unsigned int blockThreads, void **args) {
+        if (r == CUDA_SUCCESS) {
+            r = s.cu.cuLaunchKernel(f, groups, 1, 1, blockThreads, 1, 1, 0, nullptr, args, nullptr);
+        }
+    };
+    auto upload = [&](Buffer &b, const void *data, size_t bytes) {
+        if (r == CUDA_SUCCESS) r = reserve(s, b, bytes + 8);
+        if (r == CUDA_SUCCESS && bytes > 0) r = s.cu.cuMemcpyHtoD(b.ptr, data, bytes);
+    };
+    unsigned int groups = (unsigned int)((n + threads - 1) / threads);
+    auto dot = [&](CUdeviceptr x, CUdeviceptr y) -> double {
+        int nn = n;
+        void *args[] = {&x, &y, &nn, &s.pcgPartials.ptr};
+        launch(s.pcgDot, partialBlocks, threads, args);
+        if (r == CUDA_SUCCESS) r = s.cu.cuMemcpyDtoH(partials.data(), s.pcgPartials.ptr, partialBlocks * sizeof(double));
+        double sum = 0.0;
+        for (double p : partials) sum += p;
+        return sum;
+    };
+    auto absMax = [&](CUdeviceptr x) -> double {
+        int nn = n;
+        void *args[] = {&x, &nn, &s.pcgPartials.ptr};
+        launch(s.pcgAbsmax, partialBlocks, threads, args);
+        if (r == CUDA_SUCCESS) r = s.cu.cuMemcpyDtoH(partials.data(), s.pcgPartials.ptr, partialBlocks * sizeof(double));
+        double m = 0.0;
+        for (double p : partials) m = std::max(m, p);
+        return m;
+    };
+    // BLAS::addScaled(float alpha, x, y): y += alpha * x
+    auto axpy = [&](double alpha, CUdeviceptr x, CUdeviceptr y) {
+        double alphaFloat = (double)(float)alpha;
+        int nn = n;
+        void *args[] = {&alphaFloat, &x, &y, &nn};
+        launch(s.pcgAxpy, groups, threads, args);
+    };
+    auto precondition = [&](CUdeviceptr rhs, CUdeviceptr z) {
+        int levelsL = numLevelsL, levelsU = numLevelsU;
+        void *lowerArgs[] = {&s.pcgLevelStartL.ptr, &levelsL, &s.pcgLevelRowsL.ptr,
+                             &s.pcgLowStart.ptr, &s.pcgLowCol.ptr, &s.pcgLowValue.ptr,
+                             &s.pcgInvdiag.ptr, &rhs, &z};
+        launch(s.pcgLower, 1, 512, lowerArgs);
+        void *upperArgs[] = {&s.pcgLevelStartU.ptr, &levelsU, &s.pcgLevelRowsU.ptr,
+                             &s.pcgColstart.ptr, &s.pcgRowindex.ptr, &s.pcgFactorValue.ptr,
+                             &s.pcgInvdiag.ptr, &z};
+        launch(s.pcgUpper, 1, 512, upperArgs);
+    };
+
+    do {
+        step = "Copying the pressure system to the GPU";
+        upload(s.pcgRowstart, in.rowstart, (size_t)(n + 1) * sizeof(unsigned int));
+        upload(s.pcgColindex, in.colindex, (size_t)nnz * sizeof(unsigned int));
+        upload(s.pcgValue, in.value, (size_t)nnz * sizeof(double));
+        upload(s.pcgInvdiag, in.invdiag, vecBytes);
+        upload(s.pcgColstart, in.colstart, (size_t)(n + 1) * sizeof(unsigned int));
+        upload(s.pcgRowindex, in.rowindex, (size_t)nnzL * sizeof(unsigned int));
+        upload(s.pcgFactorValue, in.factorValue, (size_t)nnzL * sizeof(double));
+        upload(s.pcgLowStart, lowStart.data(), (size_t)(n + 1) * sizeof(int));
+        upload(s.pcgLowCol, lowCol.data(), (size_t)nnzL * sizeof(int));
+        upload(s.pcgLowValue, lowValue.data(), (size_t)nnzL * sizeof(double));
+        upload(s.pcgLevelStartL, levelStartL.data(), levelStartL.size() * sizeof(int));
+        upload(s.pcgLevelRowsL, levelRowsL.data(), levelRowsL.size() * sizeof(int));
+        upload(s.pcgLevelStartU, levelStartU.data(), levelStartU.size() * sizeof(int));
+        upload(s.pcgLevelRowsU, levelRowsU.data(), levelRowsU.size() * sizeof(int));
+        upload(s.pcgR, in.rhs, vecBytes);
+        upload(s.pcgX, result, vecBytes);
+        if (r == CUDA_SUCCESS) r = reserve(s, s.pcgZ, vecBytes + 8);
+        if (r == CUDA_SUCCESS) r = reserve(s, s.pcgS, vecBytes + 8);
+        if (r == CUDA_SUCCESS) r = reserve(s, s.pcgPartials, partialBlocks * sizeof(double));
+        if (r != CUDA_SUCCESS) break;
+
+        // PCGSolver::solve
+        step = "Pressure solve on the GPU";
+        out = PCGResult();
+        out.residual = absMax(s.pcgR.ptr);
+        if (r != CUDA_SUCCESS) break;
+        if (out.residual == 0) {
+            out.iterations = 0;
+            out.converged = true;
+            break;
+        }
+        double tol = in.toleranceFactor * out.residual;
+
+        precondition(s.pcgR.ptr, s.pcgZ.ptr);
+        double rho = dot(s.pcgZ.ptr, s.pcgR.ptr);
+        if (r != CUDA_SUCCESS) break;
+        if (rho == 0 || rho != rho) {
+            out.iterations = 0;
+            out.converged = false;
+            break;
+        }
+
+        int nn = n;
+        void *copyArgs[] = {&s.pcgZ.ptr, &s.pcgS.ptr, &nn};
+        launch(s.pcgCopy, groups, threads, copyArgs);
+
+        int iteration;
+        bool done = false;
+        for (iteration = 0; iteration < in.maxIterations && r == CUDA_SUCCESS; iteration++) {
+            void *spmvArgs[] = {&s.pcgRowstart.ptr, &s.pcgColindex.ptr, &s.pcgValue.ptr,
+                                &s.pcgS.ptr, &s.pcgZ.ptr, &nn};
+            launch(s.pcgSpmv, groups, threads, spmvArgs);
+            double alpha = rho / dot(s.pcgS.ptr, s.pcgZ.ptr);
+            axpy(alpha, s.pcgS.ptr, s.pcgX.ptr);
+            axpy(-alpha, s.pcgZ.ptr, s.pcgR.ptr);
+
+            out.residual = absMax(s.pcgR.ptr);
+            if (r != CUDA_SUCCESS) break;
+            if (out.residual <= std::min(tol, in.maxErrorTolerance)) {
+                out.iterations = iteration + 1;
+                out.converged = true;
+                done = true;
+                break;
+            }
+
+            precondition(s.pcgR.ptr, s.pcgZ.ptr);
+            double rhoNew = dot(s.pcgZ.ptr, s.pcgR.ptr);
+            double beta = rhoNew / rho;
+            axpy(beta, s.pcgS.ptr, s.pcgZ.ptr);
+            std::swap(s.pcgS, s.pcgZ);          // s = beta*s + z
+            rho = rhoNew;
+        }
+        if (r != CUDA_SUCCESS) break;
+        if (!done) {
+            out.iterations = iteration;
+            out.converged = false;
+        }
+    } while (false);
+
+    if (r == CUDA_SUCCESS) {
+        step = "Copying the pressure from the GPU";
+        r = s.cu.cuMemcpyDtoH(result, s.pcgX.ptr, vecBytes);
+    }
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        releaseLocked(s);
+        fallbackCount[STEP_PRESSURE]++;
+        return false;
+    }
+    gpuCount[STEP_PRESSURE]++;
+    return true;
+}
+
+void release() {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    releaseLocked(s);
+}
+
+void resetCounters() {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    for (int i = 0; i < NUM_STEPS; i++) {
+        gpuCount[i] = 0;
+        fallbackCount[i] = 0;
+        verifyMismatches[i] = 0;
+        verifyCompared[i] = 0;
+        verifyMaxDiff[i] = 0.0;
+        verifyGPUTime[i] = 0.0;
+        verifyCPUTime[i] = 0.0;
+    }
+}
+
+int getGPUCount(int step) {
+    return validStep(step) ? gpuCount[step].load() : 0;
+}
+
+int getFallbackCount(int step) {
+    return validStep(step) ? fallbackCount[step].load() : 0;
+}
+
+void setVerifyEnabled(bool enabled) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.verify = enabled;
+}
+
+bool isVerifyEnabled() {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    return s.verify;
+}
+
+void addVerifyResult(int step, long long mismatches, long long compared) {
+    if (validStep(step)) {
+        verifyMismatches[step] += mismatches;
+        verifyCompared[step] += compared;
+    }
+}
+
+long long getVerifyMismatches(int step) {
+    return validStep(step) ? verifyMismatches[step].load() : 0;
+}
+
+long long getVerifyCompared(int step) {
+    return validStep(step) ? verifyCompared[step].load() : 0;
+}
+
+void addVerifyMaxDiff(int step, double difference) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (validStep(step) && difference > verifyMaxDiff[step]) {
+        verifyMaxDiff[step] = difference;
+    }
+}
+
+double getVerifyMaxDiff(int step) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    return validStep(step) ? verifyMaxDiff[step] : 0.0;
+}
+
+void addVerifyTiming(int step, double gpuSeconds, double cpuSeconds) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (validStep(step)) {
+        verifyGPUTime[step] += gpuSeconds;
+        verifyCPUTime[step] += cpuSeconds;
+    }
+}
+
+double getVerifyGPUTime(int step) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    return validStep(step) ? verifyGPUTime[step] : 0.0;
+}
+
+double getVerifyCPUTime(int step) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    return validStep(step) ? verifyCPUTime[step] : 0.0;
+}
+
+}
