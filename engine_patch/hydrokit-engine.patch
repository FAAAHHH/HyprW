+// Does cell (i, j, k) create the vertex of its own edge e (no earlier cell
+// in the CPU's order shares the edge)?
+__device__ __forceinline__ bool hk_mc_creates(int e, int i, int j, int k) {
+    switch (e) {
+        case 0: return j == 0 && k == 0;
+        case 1: return j == 0;
+        case 2: return j == 0;
+        case 3: return i == 0 && j == 0;
+        case 4: return k == 0;
+        case 7: return i == 0;
+        case 8: return i == 0 && k == 0;
+        case 9: return k == 0;
+        case 11: return i == 0;
+        default: return true;           // 5, 6, 10: always the first cell
+    }
+}
