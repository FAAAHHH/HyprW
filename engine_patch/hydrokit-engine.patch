+        }
+        HKGPU::addVerifyResult(HKGPU::STEP_ADVECTION, mismatches, n);
+        HKGPU::addVerifyMaxDiff(HKGPU::STEP_ADVECTION, maxDiff);
+        return true;
+    }
+
+    std::memcpy(values, field.data(), (size_t)n * sizeof(float));
+    bool *validValues = validgrid->getRawArray();
+    for (int i = 0; i < n; i++) {
+        if (valid[i]) {
+            validValues[i] = true;
+        }
+    }
