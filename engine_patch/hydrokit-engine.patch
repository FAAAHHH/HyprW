+        return HKGPU::computeMesherScalarField(in, field, HKGPU::STEP_MESH, &preview,
+                                               &_gpuPreviewValues, &_gpuPreviewSet);
+    }
+
+    return HKGPU::computeMesherScalarField(in, field, HKGPU::STEP_MESH);
+}
