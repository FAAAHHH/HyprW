+bool ParticleMesher::_computeScalarFieldGPU(ScalarFieldData &fieldData, std::vector<float> &field) {
+    static_assert(sizeof(vmath::vec3) == 3 * sizeof(float), "vec3 must be three packed floats");
+
+    MesherComputeChunk &chunk = fieldData.computeChunk;
+    BlockArray3dParameters blockParams;
+    blockParams.isize = chunk.isize;
+    blockParams.jsize = chunk.jsize;
+    blockParams.ksize = chunk.ksize;
+    blockParams.blockwidth = _blockwidth;
+    Dims3d blockDims = BlockArray3d<float>::getBlockDimensions(blockParams);
+
+    std::vector<unsigned char> blockActive((size_t)blockDims.i * blockDims.j * blockDims.k, 0);
+    for (int k = 0; k < blockDims.k; k++) {
+        for (int j = 0; j < blockDims.j; j++) {
+            for (int i = 0; i < blockDims.i; i++) {
+                if (fieldData.scalarField.getBlockID(i, j, k) >= 0) {
+                    blockActive[(size_t)i + (size_t)blockDims.i * ((size_t)j + (size_t)blockDims.j * (size_t)k)] = 1;
+                }
+            }
+        }
+    }
+
+    Array3d<float> *fieldValues = fieldData.fieldValues.getPointerToScalarField();
+
+    // The same values the CPU steps use: _computeGridCountDataThread and
+    // _scalarFieldProducerThread
+    HKGPU::MesherFieldInput in;
+    in.particles = (const float *)fieldData.particles.data();
+    in.numParticles = (int)fieldData.particles.size();
+    in.blockActive = blockActive.data();
+    in.nbi = blockDims.i;
+    in.nbj = blockDims.j;
+    in.nbk = blockDims.k;
+    in.isize = fieldValues->width;
+    in.jsize = fieldValues->height;
+    in.ksize = fieldValues->depth;
+    in.blockwidth = _blockwidth;
+    in.subdx = _subdx;
+    in.blockdxFloat = (float)(_blockwidth * _subdx);
+    in.blockdxDouble = _blockwidth * _subdx;
+    in.radius = (float)_radius;
+    in.searchRadius = _searchRadiusFactor * in.radius;
+    in.maxDistance = _getMaxDistanceValue();
+
+    return HKGPU::computeMesherScalarField(in, field, HKGPU::STEP_MESH);
+}
