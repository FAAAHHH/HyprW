+vmath::vec3 DiffuseParticleSimulation::_advanceDroplet(vmath::vec3 v, vmath::vec3 g,
+                                                        double d, double dt) {
+    // dv/dt = -k (v - u) + (1 - rho_a/rho_w) g,   u = air velocity (wind)
+    // k = 3/4 Cd/d rho_a/rho_w |v - u|; in the Stokes regime k = 18 mu_a/(rho_w d^2).
+    // Solved exactly for constant k over the step — stable even for mist
+    // drops whose time constant is much smaller than the time step.
+    double ratio = HK_RHO_AIR / HK_RHO_WATER;
+    vmath::vec3 u = _windVelocity;
+    vmath::vec3 gb = (float)(1.0 - ratio) * g;
+    double s = vmath::length(v - u);
+    double re = HK_RHO_AIR * s * d / HK_MU_AIR;
+    double k;
+    if (d >= 0.5e-3) {
+        // From 0.5 mm on, drops flatten while falling and brake more strongly than
+        // the sphere formula assumes (it would be 22 % too fast at 5 mm). So the drag
+        // is quadratic, calibrated to the measured fall speed after
+        // Atlas, Srivastava & Sekhon (1973): vt = 9.65 - 10.3 exp(-0.6 D[mm]),
+        // valid up to 7 mm. At vt, k vt = g'  ->  k = g' s / vt^2.
+        double dmm = std::min(d * 1000.0, 7.0);
+        double vt = 9.65 - 10.3 * std::exp(-0.6 * dmm);
+        k = vmath::length(gb) * s / (vt * vt);
+    } else if (re <= 0.2) {
+        k = 18.0 * HK_MU_AIR / (HK_RHO_WATER * d * d);
+    } else {
+        double cd = (re <= 800.0) ? 24.0 / re * (1.0 + 0.15 * std::pow(re, 0.687)) : 0.44;
+        k = 0.75 * cd / d * ratio * s;
+    }
+    if (k * dt < 1e-9) {
+        return v + gb * (float)dt;
+    }
+    vmath::vec3 vend = u + gb / (float)k;        // terminal velocity relative to the air
+    return vend + (v - vend) * (float)std::exp(-k * dt);
+}
+
+double DiffuseParticleSimulation::_splashK(double vn, double d) {
+    // K = We * Oh^-0.4, both with water properties and drop diameter
+    double we = HK_RHO_WATER * vn * vn * d / HK_SIGMA;
+    double oh = HK_MU_WATER / std::sqrt(HK_RHO_WATER * HK_SIGMA * d);
+    return we * std::pow(oh, -0.4);
+}
+
+double DiffuseParticleSimulation::_splashMistFraction(double K) {
+    if (K <= _mistSplashK) {
+        return 0.0;
+    }
+    // Grows from the threshold and saturates (Okawa 2006: 0..1 rising with K).
+    return _mistSplashFraction * (1.0 - std::exp(-(K / _mistSplashK - 1.0) / 3.0));
+}
+
+double DiffuseParticleSimulation::_aeroBreakupRate(double vrel, double d) {
+    if (vrel < 1e-6) {
+        return 0.0;
+    }
+    double we = HK_RHO_AIR * vrel * vrel * d / HK_SIGMA;
+    if (we <= 12.0) {
+        return 0.0;      // below We 12 a drop does not break up
+    }
+    // Pilch & Erdman (1987): dimensionless total breakup time T
+    double x = we - 12.0;
+    double T;
+    if (we < 18.0)        { T = 6.0 * std::pow(x, -0.25); }
+    else if (we < 45.0)   { T = 2.45 * std::pow(x, 0.25); }
+    else if (we < 351.0)  { T = 14.1 * std::pow(x, -0.25); }
+    else if (we < 2670.0) { T = 0.766 * std::pow(x, 0.25); }
+    else                  { T = 5.5; }
+    double tstar = (d / vrel) * std::sqrt(HK_RHO_WATER / HK_RHO_AIR);
+    return 1.0 / (T * tstar);
+}
