+            _addComputeChunkScalarFieldToPreviewField(fieldData);
+        }
+        return;
+    }
+
+    bool done = false;
+    if (_useGPU) {
+        std::vector<float> gpuField;
+        StopWatch gpuTimer;
+        gpuTimer.start();
+        bool gpuDone = _computeScalarFieldGPU(fieldData, gpuField);
+        gpuTimer.stop();
+        if (gpuDone) {
+            Array3d<float> *fieldValues = fieldData.fieldValues.getPointerToScalarField();
+            int isize = fieldValues->width;
+            int jsize = fieldValues->height;
+            int ksize = fieldValues->depth;
+            if (HKGPU::isVerifyEnabled()) {
+                StopWatch cpuTimer;
+                cpuTimer.start();
+                _computeScalarFieldCPU(fieldData);
+                cpuTimer.stop();
+                HKGPU::addVerifyTiming(HKGPU::STEP_MESH, gpuTimer.getTime(), cpuTimer.getTime());
+                long long mismatches = 0;
+                for (int k = 0; k < ksize; k++) {
+                    for (int j = 0; j < jsize; j++) {
+                        for (int i = 0; i < isize; i++) {
+                            float gpuValue = -gpuField[(size_t)i + (size_t)isize * ((size_t)j + (size_t)jsize * (size_t)k)];
+                            float cpuValue = fieldValues->get(i, j, k);
+                            if (std::memcmp(&gpuValue, &cpuValue, sizeof(float)) != 0) {
+                                mismatches++;
+                            }
+                        }
+                    }
+                }
+                HKGPU::addVerifyResult(HKGPU::STEP_MESH, mismatches, (long long)isize * jsize * ksize);
+            } else {
+                for (int k = 0; k < ksize; k++) {
+                    for (int j = 0; j < jsize; j++) {
+                        for (int i = 0; i < isize; i++) {
+                            fieldValues->set(i, j, k, -gpuField[(size_t)i + (size_t)isize * ((size_t)j + (size_t)jsize * (size_t)k)]);
+                        }
+                    }
+                }
+            }
+            done = true;
+        }
+    }
+    if (!done) {
+        _computeScalarFieldCPU(fieldData);
+    }
+
+    _applyInteriorCells(fieldData);
+
+    if (_isPreviewMesherEnabled) {
+        size_t numPreview = (size_t)(_pisize + 1) * (size_t)(_pjsize + 1) * (size_t)(_pksize + 1);
+        if (done && _gpuPreviewSet.size() == numPreview) {
+            _addGPUPreviewField(fieldData);
+        } else {
