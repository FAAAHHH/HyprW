+void MeshFluidSource::setTurbulence(double intensity, double length, double seed) {
+    _turbulenceModes.clear();
+    _turbulenceIntensity = 0.0;
+    _turbulenceAmplitudeSum = 0.0;
+    if (intensity <= 0.0 || length <= 0.0) {
+        return;
+    }
+    _turbulenceIntensity = intensity;
+
+    const int nmodes = 32;
+    const double pi = 3.14159265358979323846;
+    std::mt19937 rng((unsigned int)(long long)seed);
+    std::uniform_real_distribution<double> uni(0.0, 1.0);
+    double k0 = 2.0 * pi / length;
+    double sum = 0.0;
+    while ((int)_turbulenceModes.size() < nmodes) {
+        // wavenumbers log-uniform from the largest eddy down to a quarter of
+        // it: each mode then carries energy ~ k^(-2/3), as E(k) ~ k^(-5/3)
+        double k = k0 * pow(4.0, uni(rng));
+        double z = 2.0 * uni(rng) - 1.0;
+        double phi = 2.0 * pi * uni(rng);
+        double r = sqrt(std::max(1.0 - z * z, 0.0));
+        double kh[3] = {r * cos(phi), r * sin(phi), z};
+        // the amplitude perpendicular to k keeps the field divergence-free
+        double q[3] = {2.0 * uni(rng) - 1.0, 2.0 * uni(rng) - 1.0, 2.0 * uni(rng) - 1.0};
+        double a[3] = {kh[1] * q[2] - kh[2] * q[1],
+                       kh[2] * q[0] - kh[0] * q[2],
+                       kh[0] * q[1] - kh[1] * q[0]};
+        double alen = sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
+        double phase = 2.0 * pi * uni(rng);
+        if (alen < 1e-6) {
+            continue;
+        }
+        double amp = pow(k / k0, -1.0 / 3.0);
+        TurbulenceMode m;
+        for (int c = 0; c < 3; c++) {
+            m.k[c] = k * kh[c];
+            m.a[c] = amp * a[c] / alen;
+        }
+        m.phase = phase;
+        m.klen = k;
+        _turbulenceModes.push_back(m);
+        sum += amp * amp;
+    }
+    // each component's variance 1: <u.u> = sum |a|^2 / 2 = 3
+    double s = sqrt(6.0 / sum);
+    for (size_t n = 0; n < _turbulenceModes.size(); n++) {
+        TurbulenceMode &m = _turbulenceModes[n];
+        double alen = 0.0;
+        for (int c = 0; c < 3; c++) {
+            m.a[c] *= s;
+            alen += m.a[c] * m.a[c];
+        }
+        _turbulenceAmplitudeSum += sqrt(alen);
+    }
+}
+
+double MeshFluidSource::getTurbulenceIntensity() {
+    return _turbulenceIntensity;
+}
+
+vmath::vec3 MeshFluidSource::getTurbulentVelocity(vmath::vec3 p, double time) {
+    vmath::vec3 v = _sourceVelocity;
+    if (_turbulenceModes.empty()) {
+        return v;
+    }
+    double speed = vmath::length(v);
+    double sigma = _turbulenceIntensity * speed;
+    if (sigma <= 0.0) {
+        return v;
+    }
+    double x[3] = {p.x - time * v.x, p.y - time * v.y, p.z - time * v.z};
+    double u[3] = {0.0, 0.0, 0.0};
+    for (size_t n = 0; n < _turbulenceModes.size(); n++) {
+        const TurbulenceMode &m = _turbulenceModes[n];
+        double arg = m.k[0] * x[0] + m.k[1] * x[1] + m.k[2] * x[2] + m.phase + m.klen * sigma * time;
+        double c = cos(arg);
+        u[0] += c * m.a[0];
+        u[1] += c * m.a[1];
+        u[2] += c * m.a[2];
+    }
+    vmath::vec3 fl((float)(sigma * u[0]), (float)(sigma * u[1]), (float)(sigma * u[2]));
+
+    return v + fl;
+}
+
+bool MeshFluidSource::_isInOutletLayer(vmath::vec3 p) {
+    float d = trilinearInterpolate(p);
+    if (d <= 0.0f || d > 2.0 * _dx) {
+        return false;
+    }
+    float h = (float)(0.5 * _dx);
+    vmath::vec3 ex(h, 0.0f, 0.0f), ey(0.0f, h, 0.0f), ez(0.0f, 0.0f, h);
+    vmath::vec3 n(trilinearInterpolate(p + ex) - trilinearInterpolate(p - ex),
+                  trilinearInterpolate(p + ey) - trilinearInterpolate(p - ey),
+                  trilinearInterpolate(p + ez) - trilinearInterpolate(p - ez));
+    double nlen = vmath::length(n);
+    double speed = vmath::length(_sourceVelocity);
+    return nlen > 1e-9 && speed > 1e-9 && vmath::dot(n, _sourceVelocity) >= 0.5 * nlen * speed;
+}
+
+bool MeshFluidSource::getOutletTurbulenceKick(vmath::vec3 p, vmath::vec3 velocity,
+                                              double time, double dt, vmath::vec3 &kick) {
+    // Water inside the inflow moves with the mean velocity only. Turbulent
+    // velocities there opened gaps the emission refilled while crowded spots
+    // stayed (learning scene, water delivered in frames 6-12: +14 % at 10 %,
+    // +30 % at 25 %), and forcing them on the water just outside drained the
+    // inflow faster (+7.8 % particles at 10 %). Instead each particle in the
+    // two cells beyond the outlet gets the change of the turbulent velocity
+    // along its path since the last step: leaving the layer it carries
+    // u'(p, t) on top of its own flow, and the flow rate is untouched.
+    if (_turbulenceModes.empty() || !_isInOutletLayer(p)) {
+        return false;
+    }
+    vmath::vec3 previous = p - (float)dt * velocity;
+    vmath::vec3 now = getTurbulentVelocity(p, time) - _sourceVelocity;
+    if (trilinearInterpolate(previous) <= 0.0f) {
+        kick = now;
+        return true;
+    }
+    if (_isInOutletLayer(previous)) {
+        kick = now - (getTurbulentVelocity(previous, time - dt) - _sourceVelocity);
+        return true;
+    }
+    return false;
+}
+
+double MeshFluidSource::getMaxTurbulenceSpeed() {
+    // For the time step. The strict bound (sum of all amplitudes, 13.8 sigma)
+    // halved the steps for nothing: 200,000 samples reached at most 4.65 sigma
+    double sigma = _turbulenceIntensity * vmath::length(_sourceVelocity);
+    return std::min(6.0 * sigma, sigma * _turbulenceAmplitudeSum);
+}
+
