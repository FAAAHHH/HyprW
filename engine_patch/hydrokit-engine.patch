+
+/*
+    HydroKit GPU kernels. Device code only: hkgpu_build_kernels.sh compiles this
+    file into a fatbin that hkgpu_kernels_fatbin.h embeds, and hkgpu.cpp loads it
+    through the CUDA driver API at run time. So building the engine needs no CUDA
+    toolkit, and running it needs no NVIDIA driver (it then stays on the CPU).
+
+    EXACTNESS. The mesher scalar field has to match the CPU bit for bit, so that
+    the GPU mesh is the CPU mesh. Every operation repeats ParticleMesher's
+    precision and order: float where the CPU uses float, double where it
+    converts, multiplication by a reciprocal computed on the host exactly as the
+    CPU computes it, and no fused multiply-add (compiled with -fmad=false).
+    The minimum over particles does not depend on their order, so the parallel
+    result is exact as well.
+*/
+
+// Float minimum through the integer atomics. Non-negative floats order like
+// their bit patterns as signed ints; negative floats order in reverse as
+// unsigned ints. So a non-negative value can only lower a non-negative entry
+// (atomicMin on int), a negative value always wins against a non-negative
+// entry and against a less negative one (atomicMax on unsigned).
+__device__ __forceinline__ void hk_atomic_min_float(float *address, float value) {
+    if (value >= 0.0f) {
+        atomicMin((int *)address, __float_as_int(value));
+    } else {
+        atomicMax((unsigned int *)address, __float_as_uint(value));
+    }
+}
+
+/*
+    Distance field from particles: field(node) = min over particles of
+    (|node - p| - r), only within each particle's search box, only in active
+    blocks, starting from the max distance value. One thread per particle.
+    Two users with the same structure:
+      ParticleMesher::_computeScalarField   nodes at i*dx, box up to gmax + 1
+                                            (halfOffset 0, boxPlusOne 1)
+      ParticleLevelSet::_computeSignedDistanceFromParticles
+                                            cell centres i*dx + dx/2, box up
+                                            to gmax (halfOffset dx/2,
+                                            boxPlusOne 0)
+
+    Mirrors two CPU steps:
+      _computeGridCountDataThread  which blocks a particle is sorted into: only
+                                   its own block if its search box lies inside it
+                                   ("simple" case), otherwise every active block
+                                   the box overlaps
+      _scalarFieldProducerThread / _computeExactBandProducerThread
+                                   per block, in block-local coordinates: the
+                                   node box around the particle, clamped to the
+                                   block, and the distance per node
+
+    particles    chunk-local positions, x y z per particle
+    blockActive  1 for active blocks, index bi + nbi * (bj + nbj * bk)
+    field        isize x jsize x ksize nodes, index i + isize * (j + jsize * k),
+                 filled with the max distance value beforehand
+*/
+extern "C" __global__ void hk_mesher_scalar_field(
+        const float *particles, int numParticles,
+        const unsigned char *blockActive, int nbi, int nbj, int nbk,
+        float *field, int isize, int jsize, int ksize,
+        int blockwidth, double subdx, double invSubdx,
+        float blockdxFloat, double invBlockdxFloat, double blockdxDouble,
+        float r, float sr, double halfOffset, int boxPlusOne) {
+
+    int pidx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (pidx >= numParticles) {
+        return;
+    }
+
+    float px = particles[3 * pidx + 0];
+    float py = particles[3 * pidx + 1];
+    float pz = particles[3 * pidx + 2];
+
+    // _computeGridCountDataThread. CPU: float blockdx = _blockwidth * _subdx;
+    // positionToGridIndex(p, blockdx) = floor(p * (1.0 / (double)blockdx))
+    int cbi = (int)floor((double)px * invBlockdxFloat);
+    int cbj = (int)floor((double)py * invBlockdxFloat);
+    int cbk = (int)floor((double)pz * invBlockdxFloat);
+
+    // GridIndexToPosition(g, blockdx) = vec3((float)g.i * (double)blockdx, ...)
+    float bpx = (float)((double)(float)cbi * (double)blockdxFloat);
+    float bpy = (float)((double)(float)cbj * (double)blockdxFloat);
+    float bpz = (float)((double)(float)cbk * (double)blockdxFloat);
+
+    bool simple = px - sr > bpx &&
+                  py - sr > bpy &&
+                  pz - sr > bpz &&
+                  px + sr < bpx + blockdxFloat &&
+                  py + sr < bpy + blockdxFloat &&
+                  pz + sr < bpz + blockdxFloat;
+
+    int b0i = cbi, b0j = cbj, b0k = cbk;
+    int b1i = cbi, b1j = cbj, b1k = cbk;
+    if (!simple) {
+        // positionToGridIndex(p.x - sr, ..., blockdx): float differences, then double
+        b0i = (int)floor((double)(px - sr) * invBlockdxFloat);
+        b0j = (int)floor((double)(py - sr) * invBlockdxFloat);
+        b0k = (int)floor((double)(pz - sr) * invBlockdxFloat);
+        b1i = (int)floor((double)(px + sr) * invBlockdxFloat);
+        b1j = (int)floor((double)(py + sr) * invBlockdxFloat);
+        b1k = (int)floor((double)(pz + sr) * invBlockdxFloat);
+    }
+
+    for (int gk = b0k; gk <= b1k; gk++) {
+        for (int gj = b0j; gj <= b1j; gj++) {
+            for (int gi = b0i; gi <= b1i; gi++) {
+                // getBlockID: -1 outside the block grid or for inactive blocks
+                if (gi < 0 || gj < 0 || gk < 0 || gi >= nbi || gj >= nbj || gk >= nbk) {
+                    continue;
+                }
+                if (!blockActive[gi + nbi * (gj + nbj * gk)]) {
+                    continue;
+                }
+
+                // _scalarFieldProducerThread. GridIndexToPosition(blockIndex,
+                // _blockwidth * _subdx): the block offset with the DOUBLE width
+                float ox = (float)((double)(float)gi * blockdxDouble);
+                float oy = (float)((double)(float)gj * blockdxDouble);
+                float oz = (float)((double)(float)gk * blockdxDouble);
+                float lx = px - ox;
+                float ly = py - oy;
+                float lz = pz - oz;
+
+                // positionToGridIndex(pmin, dx); the mesher adds 1 to gmax
+                int g0i = (int)floor((double)(lx - sr) * invSubdx);
+                int g0j = (int)floor((double)(ly - sr) * invSubdx);
+                int g0k = (int)floor((double)(lz - sr) * invSubdx);
+                int g1i = (int)floor((double)(lx + sr) * invSubdx) + boxPlusOne;
+                int g1j = (int)floor((double)(ly + sr) * invSubdx) + boxPlusOne;
+                int g1k = (int)floor((double)(lz + sr) * invSubdx) + boxPlusOne;
+                g0i = max(g0i, 0); g0j = max(g0j, 0); g0k = max(g0k, 0);
+                g1i = min(g1i, blockwidth - 1);
+                g1j = min(g1j, blockwidth - 1);
+                g1k = min(g1k, blockwidth - 1);
+
+                for (int k = g0k; k <= g1k; k++) {
+                    int fk = gk * blockwidth + k;
+                    if (fk >= ksize) {
+                        continue;
+                    }
+                    float gz = (float)((double)(float)k * subdx + halfOffset);
+                    float dz = gz - lz;
+                    for (int j = g0j; j <= g1j; j++) {
+                        int fj = gj * blockwidth + j;
+                        if (fj >= jsize) {
+                            continue;
+                        }
+                        float gy = (float)((double)(float)j * subdx + halfOffset);
+                        float dy = gy - ly;
+                        for (int i = g0i; i <= g1i; i++) {
+                            int fi = gi * blockwidth + i;
+                            if (fi >= isize) {
+                                continue;
+                            }
+                            // GridIndexToPosition (or ToCellCenter: + 0.5*dx in
+                            // double) and length(gpos - p) - r, x*x + y*y + z*z
+                            // left to right. + 0.0 for the mesher changes no bit.
+                            float gx = (float)((double)(float)i * subdx + halfOffset);
+                            float dx = gx - lx;
+                            float lensq = dx * dx + dy * dy;
+                            lensq = lensq + dz * dz;
+                            float dist = sqrtf(lensq) - r;
+                            hk_atomic_min_float(&field[fi + isize * (fj + jsize * fk)], dist);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+// std::max / std::min exactly: they return the first argument unless the
+// comparison says otherwise, which decides the sign of a zero result
+__device__ __forceinline__ float hk_std_max(float a, float b) {
+    return (a < b) ? b : a;
+}
+
+__device__ __forceinline__ float hk_std_min(float a, float b) {
+    return (b < a) ? b : a;
+}
+
+/*
+    One pseudo-time step of LevelSetSolver::reinitializeUpwind
+    (_stepSolverThreadUpwind) for every solver cell, plus the largest change
+    of the step for the convergence test. Jacobi style like the CPU: reads
+    only cur, writes only next, so the result does not depend on the order.
+
+    cells        flat indices i + isize * (j + jsize * k)
+    maxDiffBits  float bits of the largest |next - cur|, set to 0 beforehand
+*/
+extern "C" __global__ void hk_reinit_upwind_step(
+        const float *cur, float *next, const int *cells, int numCells,
+        int isize, int jsize, int ksize, float dx, float dtau,
+        unsigned int *maxDiffBits) {
+
+    int c = blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= numCells) {
+        return;
+    }
+    int flat = cells[c];
+    int i = flat % isize;
+    int j = (flat / isize) % jsize;
+    int k = flat / (isize * jsize);
+
+    float center = cur[flat];
+
+    // _sign: double d = sdf(i, j, k); return d / std::sqrt(d * d + dx * dx);
+    // dx * dx is a float product, then converted for the double sum
+    double d = (double)center;
+    float s = (float)(d / sqrt(d * d + (double)(dx * dx)));
+
+    // _getDerivativesUpwind and _upwind1
+    int im1 = (i < 1) ? 0 : i - 1;
+    int ip1 = min(i + 1, isize - 1);
+    int jm1 = (j < 1) ? 0 : j - 1;
+    int jp1 = min(j + 1, jsize - 1);
+    int km1 = (k < 1) ? 0 : k - 1;
+    int kp1 = min(k + 1, ksize - 1);
+    float invdx = 1.0f / dx;
+    float derx0 = invdx * (center - cur[im1 + isize * (j + jsize * k)]);
+    float derx1 = invdx * (cur[ip1 + isize * (j + jsize * k)] - center);
+    float dery0 = invdx * (center - cur[i + isize * (jm1 + jsize * k)]);
+    float dery1 = invdx * (cur[i + isize * (jp1 + jsize * k)] - center);
+    float derz0 = invdx * (center - cur[i + isize * (j + jsize * km1)]);
+    float derz1 = invdx * (cur[i + isize * (j + jsize * kp1)] - center);
+
+    float a, b;
+    // sums left to right, as written in the CPU code
+    a = hk_std_max(derx0, 0.0f); float sumPositive = a * a;
+    a = hk_std_min(derx1, 0.0f); sumPositive = sumPositive + a * a;
+    a = hk_std_max(dery0, 0.0f); sumPositive = sumPositive + a * a;
+    a = hk_std_min(dery1, 0.0f); sumPositive = sumPositive + a * a;
+    a = hk_std_max(derz0, 0.0f); sumPositive = sumPositive + a * a;
+    a = hk_std_min(derz1, 0.0f); sumPositive = sumPositive + a * a;
+
+    b = hk_std_min(derx0, 0.0f); float sumNegative = b * b;
+    b = hk_std_max(derx1, 0.0f); sumNegative = sumNegative + b * b;
+    b = hk_std_min(dery0, 0.0f); sumNegative = sumNegative + b * b;
+    b = hk_std_max(dery1, 0.0f); sumNegative = sumNegative + b * b;
+    b = hk_std_min(derz0, 0.0f); sumNegative = sumNegative + b * b;
+    b = hk_std_max(derz1, 0.0f); sumNegative = sumNegative + b * b;
+
+    // val = c - dtau * max(s, 0) * (sqrt(P) - 1) - dtau * min(s, 0) * (sqrt(N) - 1)
+    float termPositive = (dtau * hk_std_max(s, 0.0f)) * (sqrtf(sumPositive) - 1.0f);
+    float termNegative = (dtau * hk_std_min(s, 0.0f)) * (sqrtf(sumNegative) - 1.0f);
+    float val = (center - termPositive) - termNegative;
+    next[flat] = val;
+
+    // maxDiff = max(|temp - output|): non-negative, so the bits order like ints
+    float diff = fabsf(val - center);
+    atomicMax(maxDiffBits, __float_as_uint(diff));
+}
+
+/*
+    VelocityAdvector, FLIP transfer (_advectionFLIPProducerThread): every
+    particle adds weight * velocity and weight to the faces of one velocity
+    component within its radius. One thread per particle; the weights are
+    computed exactly like the CPU (block-local coordinates, same float order),
+    the sums in double with atomics. The CPU adds them up in its particle
+    order in float, so the results agree to float rounding, not bit for bit.
+
+    component    0 u, 1 v, 2 w (which velocity component and face grid)
+    ox, oy, oz   _getDirectionOffset: the face position within a cell
+    sums         2 doubles per face: weighted velocity, weight
+*/
+extern "C" __global__ void hk_p2g_scatter(
+        const float *points, const float *velocities, int component, int numParticles,
+        float ox, float oy, float oz,
+        const unsigned char *blockActive, int nbi, int nbj, int nbk,
+        double *sums, int isize, int jsize, int ksize,
+        int blockwidth, double dx, double invDx,
+        float blockdxFloat, double invBlockdxFloat, double blockdxDouble,
+        float r, float sr, float rsq, float coef1, float coef2, float coef3) {
+
+    int pidx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (pidx >= numParticles) {
+        return;
+    }
+
+    // _points[i] - offset, and the velocity component
+    float px = points[3 * pidx + 0] - ox;
+    float py = points[3 * pidx + 1] - oy;
+    float pz = points[3 * pidx + 2] - oz;
+    float velocity = velocities[3 * pidx + component];
+
+    // _computeGridCountDataThread (float blockdx = _chunkdx)
+    int cbi = (int)floor((double)px * invBlockdxFloat);
+    int cbj = (int)floor((double)py * invBlockdxFloat);
+    int cbk = (int)floor((double)pz * invBlockdxFloat);
+    float bpx = (float)((double)(float)cbi * (double)blockdxFloat);
+    float bpy = (float)((double)(float)cbj * (double)blockdxFloat);
+    float bpz = (float)((double)(float)cbk * (double)blockdxFloat);
+    bool simple = px - sr > bpx && py - sr > bpy && pz - sr > bpz &&
+                  px + sr < bpx + blockdxFloat &&
+                  py + sr < bpy + blockdxFloat &&
+                  pz + sr < bpz + blockdxFloat;
+    int b0i = cbi, b0j = cbj, b0k = cbk, b1i = cbi, b1j = cbj, b1k = cbk;
+    if (!simple) {
+        b0i = (int)floor((double)(px - sr) * invBlockdxFloat);
+        b0j = (int)floor((double)(py - sr) * invBlockdxFloat);
+        b0k = (int)floor((double)(pz - sr) * invBlockdxFloat);
+        b1i = (int)floor((double)(px + sr) * invBlockdxFloat);
+        b1j = (int)floor((double)(py + sr) * invBlockdxFloat);
+        b1k = (int)floor((double)(pz + sr) * invBlockdxFloat);
+    }
+
+    for (int gk = b0k; gk <= b1k; gk++) {
+        for (int gj = b0j; gj <= b1j; gj++) {
+            for (int gi = b0i; gi <= b1i; gi++) {
+                if (gi < 0 || gj < 0 || gk < 0 || gi >= nbi || gj >= nbj || gk >= nbk) {
+                    continue;
+                }
+                if (!blockActive[gi + nbi * (gj + nbj * gk)]) {
+                    continue;
+                }
+                // _advectionFLIPProducerThread, block-local
+                float lx = px - (float)((double)(float)gi * blockdxDouble);
+                float ly = py - (float)((double)(float)gj * blockdxDouble);
+                float lz = pz - (float)((double)(float)gk * blockdxDouble);
+                int g0i = max((int)floor((double)(lx - sr) * invDx), 0);
+                int g0j = max((int)floor((double)(ly - sr) * invDx), 0);
+                int g0k = max((int)floor((double)(lz - sr) * invDx), 0);
+                int g1i = min((int)floor((double)(lx + sr) * invDx), blockwidth - 1);
+                int g1j = min((int)floor((double)(ly + sr) * invDx), blockwidth - 1);
+                int g1k = min((int)floor((double)(lz + sr) * invDx), blockwidth - 1);
+
+                for (int k = g0k; k <= g1k; k++) {
+                    int fk = gk * blockwidth + k;
+                    if (fk >= ksize) continue;
+                    float vz = (float)((double)(float)k * dx) - lz;
+                    for (int j = g0j; j <= g1j; j++) {
+                        int fj = gj * blockwidth + j;
+                        if (fj >= jsize) continue;
+                        float vy = (float)((double)(float)j * dx) - ly;
+                        for (int i = g0i; i <= g1i; i++) {
+                            int fi = gi * blockwidth + i;
+                            if (fi >= isize) continue;
+                            float vx = (float)((double)(float)i * dx) - lx;
+                            // dot(v, v) and the weight, as written in the CPU code
+                            float d2 = vx * vx + vy * vy;
+                            d2 = d2 + vz * vz;
+                            if (d2 < rsq) {
+                                float weight = ((1.0f - ((coef1 * d2) * d2) * d2)
+                                                + (coef2 * d2) * d2) - coef3 * d2;
+                                size_t f = (size_t)fi + (size_t)isize * ((size_t)fj + (size_t)jsize * (size_t)fk);
+                                atomicAdd(&sums[2 * f + 0], (double)(weight * velocity));
+                                atomicAdd(&sums[2 * f + 1], (double)weight);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+// Normalisation as in _advectionFLIPProducerThread: divide by the weight
+// where it exceeds eps; valid where it does
+extern "C" __global__ void hk_p2g_finish(const double *sums, int numFaces, float eps,
+                                         float *field, unsigned char *valid) {
+    int f = blockIdx.x * blockDim.x + threadIdx.x;
+    if (f >= numFaces) {
+        return;
+    }
+    float scalar = (float)sums[2 * f + 0];
+    float weight = (float)sums[2 * f + 1];
+    field[f] = (weight > eps) ? scalar / weight : scalar;
+    valid[f] = (weight > eps) ? 1 : 0;
+}
+
+/*
+    Pressure: PCGSolver (pcgsolver/pcgsolver.h) on the GPU, double precision.
+    Matrix product, vector updates and both triangular solves of the MIC(0)
+    preconditioner repeat the CPU operations exactly. Only the dot products
+    are summed as a tree instead of one after the other, so the solution
+    agrees with the CPU to rounding, and meets the same convergence test.
+*/
+
+// multiply(FixedSparseMatrix, x, result): row by row in stored order
+extern "C" __global__ void hk_pcg_spmv(const unsigned int *rowstart, const unsigned int *colindex,
+                                       const double *value, const double *x, double *y, int n) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    double sum = 0.0;
+    for (unsigned int j = rowstart[i]; j < rowstart[i + 1]; j++) {
+        sum = sum + value[j] * x[colindex[j]];
+    }
+    y[i] = sum;
+}
+
+// addScaled(alpha, x, y): y += alpha * x — alpha arrives already rounded to
+// float, as BLAS::addScaled takes it
+extern "C" __global__ void hk_pcg_axpy(double alpha, const double *x, double *y, int n) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) {
+        y[i] = y[i] + alpha * x[i];
+    }
+}
+
+extern "C" __global__ void hk_pcg_copy(const double *x, double *y, int n) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) {
+        y[i] = x[i];
+    }
+}
+
+// Partial dot products / absolute maxima, one per block: fixed grid, fixed
+// order, so the result is the same every time
+extern "C" __global__ void hk_pcg_dot(const double *x, const double *y, int n, double *partials) {
+    __shared__ double cache[256];
+    double sum = 0.0;
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+        sum = sum + x[i] * y[i];
+    }
+    cache[threadIdx.x] = sum;
+    __syncthreads();
+    for (int stride = blockDim.x / 2; stride > 0; stride /= 2) {
+        if (threadIdx.x < stride) {
+            cache[threadIdx.x] = cache[threadIdx.x] + cache[threadIdx.x + stride];
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        partials[blockIdx.x] = cache[0];
+    }
+}
+
+extern "C" __global__ void hk_pcg_absmax(const double *x, int n, double *partials) {
+    __shared__ double cache[256];
+    double m = 0.0;
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) {
+        m = fmax(m, fabs(x[i]));
+    }
+    cache[threadIdx.x] = m;
+    __syncthreads();
+    for (int stride = blockDim.x / 2; stride > 0; stride /= 2) {
+        if (threadIdx.x < stride) {
+            cache[threadIdx.x] = fmax(cache[threadIdx.x], cache[threadIdx.x + stride]);
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        partials[blockIdx.x] = cache[0];
+    }
+}
+
+/*
+    solveLower(icfactor, rhs, y) row by row: y[r] = (rhs[r] - sum over the
+    lower neighbours c, ascending, of L(r, c) y[c]) * invdiag[r] — the same
+    subtractions in the same order as the CPU's column loop. Rows of one
+    level depend only on earlier levels. One block, levels in order.
+*/
+extern "C" __global__ void hk_pcg_lower(const int *levelStart, int numLevels, const int *levelRows,
+                                        const int *lowStart, const int *lowCol, const double *lowValue,
+                                        const double *invdiag, const double *rhs, double *y) {
+    for (int l = 0; l < numLevels; l++) {
+        for (int t = levelStart[l] + threadIdx.x; t < levelStart[l + 1]; t += blockDim.x) {
+            int r = levelRows[t];
+            double v = rhs[r];
+            for (int j = lowStart[r]; j < lowStart[r + 1]; j++) {
+                v = v - lowValue[j] * y[lowCol[j]];
+            }
+            y[r] = v * invdiag[r];
+        }
+        __syncthreads();
+    }
+}
+
+// solveLowerTransposeInPlace(icfactor, x): x[i] -= L(r, i) x[r] for the
+// column's entries in stored order, then x[i] *= invdiag[i]; levels from the
+// last rows backwards
+extern "C" __global__ void hk_pcg_upper(const int *levelStart, int numLevels, const int *levelRows,
+                                        const unsigned int *colstart, const unsigned int *rowindex,
+                                        const double *value, const double *invdiag, double *x) {
+    for (int l = 0; l < numLevels; l++) {
+        for (int t = levelStart[l] + threadIdx.x; t < levelStart[l + 1]; t += blockDim.x) {
+            int i = levelRows[t];
+            double v = x[i];
+            for (unsigned int j = colstart[i]; j < colstart[i + 1]; j++) {
+                v = v - value[j] * x[rowindex[j]];
+            }
