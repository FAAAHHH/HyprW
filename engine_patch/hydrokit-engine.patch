+// With the context current: exclusive prefix sum of n ints from in to out
+// (in == out: in place) — hk_scan_block per 1024, the block sums scanned the
+// same way, then hk_scan_add; total gets the sum of all n
+CUresult scanInto(State &s, CUdeviceptr in, CUdeviceptr out, int n, int &total, int level) {
+    const int width = 1024;
+    if (level >= 4) {
+        return (CUresult)1;     // CUDA_ERROR_INVALID_VALUE
+    }
+    int blocks = (n + width - 1) / width;
+    CUresult r = reserve(s, s.mcScan[level], (size_t)blocks * sizeof(int));
+    if (r != CUDA_SUCCESS) {
+        return r;
+    }
+    CUdeviceptr sums = s.mcScan[level].ptr;
+    void *args[] = {&in, &out, &n, &sums};
+    if ((r = s.cu.cuLaunchKernel(s.scanBlock, blocks, 1, 1, width, 1, 1,
+                                 0, nullptr, args, nullptr)) != CUDA_SUCCESS) {
+        return r;
+    }
+    if (blocks == 1) {
+        return s.cu.cuMemcpyDtoH(&total, sums, sizeof(int));
+    }
+    if ((r = scanInto(s, sums, sums, blocks, total, level + 1)) != CUDA_SUCCESS) {
+        return r;
+    }
+    void *addArgs[] = {&out, &n, &sums};
+    return s.cu.cuLaunchKernel(s.scanAdd, blocks, 1, 1, width, 1, 1, 0, nullptr, addArgs, nullptr);
+}
+
+CUresult scanInPlace(State &s, CUdeviceptr data, int n, int &total, int level) {
+    return scanInto(s, data, data, n, total, level);
+}
+
+}
+
+bool polygonizeSurface(const PolygonizeInput &in, std::vector<float> &vertices,
+                       std::vector<int> &triangles, int countStep) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!validStep(countStep)) {
+        countStep = STEP_MESH;
+    }
+    vertices.clear();
+    triangles.clear();
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[countStep]++;
+        return false;
+    }
+
+    int ci = in.ni - 1, cj = in.nj - 1, ck = in.nk - 1;
+    if (ci <= 0 || cj <= 0 || ck <= 0) {
+        gpuCount[countStep]++;
+        return true;
+    }
+    size_t numNodes = (size_t)in.ni * (size_t)in.nj * (size_t)in.nk;
+    size_t numCells = (size_t)ci * (size_t)cj * (size_t)ck;
+    if (numCells > (size_t)2000000000) {
+        fallbackCount[countStep]++;
+        return false;
+    }
+    size_t numPhi = in.hasSolidSDF && in.solidPhi != nullptr ?
+                    (size_t)in.si * (size_t)in.sj * (size_t)in.sk : 0;
+
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    do {
+        step = "GPU memory";
+        if ((r = reserve(s, s.mcValues, numNodes * sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.mcSolid, numNodes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.mcPhi, (numPhi > 0 ? numPhi : 1) * sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.mcCellVerts, numCells * sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.mcCellTris, numCells * sizeof(int))) != CUDA_SUCCESS) break;
+
+        step = "Copying to the GPU";
+        if ((r = s.cu.cuMemcpyHtoD(s.mcValues.ptr, in.values, numNodes * sizeof(float))) != CUDA_SUCCESS) break;
+        if (in.solidVertex != nullptr) {
+            if ((r = s.cu.cuMemcpyHtoD(s.mcSolid.ptr, in.solidVertex, numNodes)) != CUDA_SUCCESS) break;
+        } else {
+            std::vector<unsigned char> none(numNodes, 0);
+            if ((r = s.cu.cuMemcpyHtoD(s.mcSolid.ptr, none.data(), numNodes)) != CUDA_SUCCESS) break;
+        }
+        if (numPhi > 0) {
+            if ((r = s.cu.cuMemcpyHtoD(s.mcPhi.ptr, in.solidPhi, numPhi * sizeof(float))) != CUDA_SUCCESS) break;
+        }
+
+        int ni = in.ni, nj = in.nj, nk = in.nk;
+        double threshold = in.threshold;
+        double dx = in.dx;
+        int hasSolid = in.hasSolidSDF ? 1 : 0;
+        int si = numPhi > 0 ? in.si : 0;
+        int sj = numPhi > 0 ? in.sj : 0;
+        int sk = numPhi > 0 ? in.sk : 0;
+        double sdx = in.solidDx;
+        float ox = in.offset[0], oy = in.offset[1], oz = in.offset[2];
+        unsigned int threads = 256;
+        unsigned int groups = (unsigned int)((numCells + threads - 1) / threads);
+
+        step = "Marching cubes kernels";
+        void *countArgs[] = {&s.mcValues.ptr, &s.mcSolid.ptr, &ni, &nj, &nk, &threshold,
+                             &s.mcCellVerts.ptr, &s.mcCellTris.ptr};
+        if ((r = s.cu.cuLaunchKernel(s.mcCount, groups, 1, 1, threads, 1, 1,
+                                     0, nullptr, countArgs, nullptr)) != CUDA_SUCCESS) break;
+        int totalVerts = 0, totalTris = 0;
+        if ((r = scanInPlace(s, s.mcCellVerts.ptr, (int)numCells, totalVerts, 0)) != CUDA_SUCCESS) break;
+        if ((r = scanInPlace(s, s.mcCellTris.ptr, (int)numCells, totalTris, 0)) != CUDA_SUCCESS) break;
+        if (totalVerts < 0 || totalTris < 0) {
+            r = (CUresult)1;    // CUDA_ERROR_INVALID_VALUE
+            break;
+        }
+
+        step = "GPU memory";
+        if ((r = reserve(s, s.mcVertices, ((size_t)totalVerts * 3 + 1) * sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.mcTriangles, ((size_t)totalTris * 3 + 1) * sizeof(int))) != CUDA_SUCCESS) break;
+
+        step = "Marching cubes kernels";
+        void *vertexArgs[] = {&s.mcValues.ptr, &s.mcSolid.ptr, &ni, &nj, &nk, &threshold, &dx,
+                              &hasSolid, &s.mcPhi.ptr, &si, &sj, &sk, &sdx, &ox, &oy, &oz,
+                              &s.mcCellVerts.ptr, &s.mcVertices.ptr};
+        if ((r = s.cu.cuLaunchKernel(s.mcVertexKernel, groups, 1, 1, threads, 1, 1,
+                                     0, nullptr, vertexArgs, nullptr)) != CUDA_SUCCESS) break;
+        void *triangleArgs[] = {&s.mcValues.ptr, &s.mcSolid.ptr, &ni, &nj, &nk, &threshold,
+                                &s.mcCellVerts.ptr, &s.mcCellTris.ptr, &s.mcTriangles.ptr};
+        if ((r = s.cu.cuLaunchKernel(s.mcTriangleKernel, groups, 1, 1, threads, 1, 1,
+                                     0, nullptr, triangleArgs, nullptr)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuCtxSynchronize()) != CUDA_SUCCESS) break;
+
+        step = "Copying from the GPU";
+        vertices.resize((size_t)totalVerts * 3);
+        triangles.resize((size_t)totalTris * 3);
+        if (totalVerts > 0 &&
+            (r = s.cu.cuMemcpyDtoH(vertices.data(), s.mcVertices.ptr,
+                                   vertices.size() * sizeof(float))) != CUDA_SUCCESS) break;
+        if (totalTris > 0) {
+            r = s.cu.cuMemcpyDtoH(triangles.data(), s.mcTriangles.ptr, triangles.size() * sizeof(int));
+        }
+    } while (false);
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        releaseLocked(s);
+        fallbackCount[countStep]++;
+        vertices.clear();
+        triangles.clear();
+        return false;
+    }
+    gpuCount[countStep]++;
+    return true;
+}
+
+bool smoothMesh(float *vertices, int numVertices, const int *triangles, int numTriangles,
+                double value, int iterations, int countStep) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!validStep(countStep)) {
+        countStep = STEP_MESH;
+    }
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[countStep]++;
+        return false;
+    }
+    if (numVertices <= 0 || iterations <= 0) {
+        gpuCount[countStep]++;
+        return true;
+    }
+    size_t vertexBytes = (size_t)numVertices * 3 * sizeof(float);
+    size_t numTris = numTriangles > 0 ? (size_t)numTriangles : 0;
+
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    do {
+        step = "GPU memory";
+        if ((r = reserve(s, s.smVertsA, vertexBytes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.smVertsB, vertexBytes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.smTris, (numTris * 3 + 1) * sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.smCounts, (size_t)numVertices * sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.smOffsets, (size_t)numVertices * sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.smCursor, (size_t)numVertices * sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.smLists, (numTris * 3 + 1) * sizeof(int))) != CUDA_SUCCESS) break;
+
+        step = "Copying to the GPU";
+        if ((r = s.cu.cuMemcpyHtoD(s.smVertsA.ptr, vertices, vertexBytes)) != CUDA_SUCCESS) break;
+        if (numTris > 0 &&
+            (r = s.cu.cuMemcpyHtoD(s.smTris.ptr, triangles, numTris * 3 * sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuMemsetD32(s.smCounts.ptr, 0u, (size_t)numVertices)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuMemsetD32(s.smCursor.ptr, 0u, (size_t)numVertices)) != CUDA_SUCCESS) break;
+
+        step = "Smoothing kernels";
+        unsigned int threads = 256;
+        int nt = (int)numTris;
+        int nv = numVertices;
+        unsigned int triGroups = (unsigned int)((numTris + threads - 1) / threads);
+        unsigned int vertGroups = (unsigned int)(((size_t)numVertices + threads - 1) / threads);
+        if (numTris > 0) {
+            void *countArgs[] = {&s.smTris.ptr, &nt, &s.smCounts.ptr};
+            if ((r = s.cu.cuLaunchKernel(s.smCount, triGroups, 1, 1, threads, 1, 1,
+                                         0, nullptr, countArgs, nullptr)) != CUDA_SUCCESS) break;
+        }
+        int totalSlots = 0;
+        if ((r = scanInto(s, s.smCounts.ptr, s.smOffsets.ptr, nv, totalSlots, 0)) != CUDA_SUCCESS) break;
+        if (numTris > 0) {
+            void *fillArgs[] = {&s.smTris.ptr, &nt, &s.smOffsets.ptr, &s.smCursor.ptr, &s.smLists.ptr};
+            if ((r = s.cu.cuLaunchKernel(s.smFill, triGroups, 1, 1, threads, 1, 1,
+                                         0, nullptr, fillArgs, nullptr)) != CUDA_SUCCESS) break;
+            void *sortArgs[] = {&s.smOffsets.ptr, &s.smCounts.ptr, &nv, &s.smLists.ptr};
+            if ((r = s.cu.cuLaunchKernel(s.smSort, vertGroups, 1, 1, threads, 1, 1,
+                                         0, nullptr, sortArgs, nullptr)) != CUDA_SUCCESS) break;
+        }
+        float smoothValue = (float)value;
+        CUdeviceptr from = s.smVertsA.ptr, to = s.smVertsB.ptr;
+        for (int it = 0; it < iterations && r == CUDA_SUCCESS; it++) {
+            void *stepArgs[] = {&from, &to, &nv, &s.smTris.ptr, &s.smOffsets.ptr,
+                                &s.smCounts.ptr, &s.smLists.ptr, &smoothValue};
+            r = s.cu.cuLaunchKernel(s.smStep, vertGroups, 1, 1, threads, 1, 1,
+                                    0, nullptr, stepArgs, nullptr);
+            CUdeviceptr t = from;
+            from = to;
+            to = t;
+        }
+        if (r != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuCtxSynchronize()) != CUDA_SUCCESS) break;
+
+        step = "Copying from the GPU";
+        r = s.cu.cuMemcpyDtoH(vertices, from, vertexBytes);
+    } while (false);
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        releaseLocked(s);
+        fallbackCount[countStep]++;
+        return false;
+    }
+    gpuCount[countStep]++;
+    return true;
+}
+
+bool reinitializeUpwind(const ReinitInput &in, float *output) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[STEP_CURVATURE]++;
+        return false;
+    }
+
+    size_t numNodes = (size_t)in.isize * (size_t)in.jsize * (size_t)in.ksize;
+    size_t gridBytes = numNodes * sizeof(float);
+    int numCells = (int)in.cells->size();
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    do {
+        step = "GPU memory";
+        if ((r = reserve(s, s.reinitA, gridBytes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.reinitB, gridBytes)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.reinitCells, (size_t)numCells * sizeof(int) + sizeof(int))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.reinitMax, sizeof(unsigned int))) != CUDA_SUCCESS) break;
+
+        // Both buffers start as the input — as LevelSetSolver does since
+        // HydroKit fixed its uninitialized temporary grid
+        step = "Copying to the GPU";
+        if ((r = s.cu.cuMemcpyHtoD(s.reinitA.ptr, in.inputSDF, gridBytes)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuMemcpyHtoD(s.reinitB.ptr, in.inputSDF, gridBytes)) != CUDA_SUCCESS) break;
+        if (numCells > 0 &&
+                (r = s.cu.cuMemcpyHtoD(s.reinitCells.ptr, in.cells->data(), (size_t)numCells * sizeof(int))) != CUDA_SUCCESS) break;
+
+        CUdeviceptr cur = s.reinitA.ptr;
+        CUdeviceptr next = s.reinitB.ptr;
+        int isize = in.isize, jsize = in.jsize, ksize = in.ksize;
+        float dx = in.dx, dtau = in.dtau;
+        unsigned int threads = 128;
+        unsigned int groups = (unsigned int)((numCells + threads - 1) / threads);
+
+        // The CPU loop of reinitializeUpwind, with the same convergence test
+        float lastMaxDiff = -1.0f;
+        for (int n = 0; n < in.numIterations && numCells > 0; n++) {
+            step = "Reinitialization kernel";
+            if ((r = s.cu.cuMemsetD32(s.reinitMax.ptr, 0u, 1)) != CUDA_SUCCESS) break;
+            void *args[] = {&cur, &next, &s.reinitCells.ptr, &numCells,
+                            &isize, &jsize, &ksize, &dx, &dtau, &s.reinitMax.ptr};
+            if ((r = s.cu.cuLaunchKernel(s.reinitStep, groups, 1, 1, threads, 1, 1,
+                                         0, nullptr, args, nullptr)) != CUDA_SUCCESS) break;
+            unsigned int maxBits = 0;
+            if ((r = s.cu.cuMemcpyDtoH(&maxBits, s.reinitMax.ptr, sizeof(maxBits))) != CUDA_SUCCESS) break;
+            float maxDiff;
+            std::memcpy(&maxDiff, &maxBits, sizeof(maxDiff));
+
+            std::swap(cur, next);
+            if (std::abs(maxDiff - lastMaxDiff) < in.errorThreshold) {
+                break;
+            }
+            lastMaxDiff = maxDiff;
+        }
+        if (r != CUDA_SUCCESS) break;
+
+        step = "Copying from the GPU";
+        r = s.cu.cuMemcpyDtoH(output, cur, gridBytes);
+    } while (false);
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        releaseLocked(s);
+        fallbackCount[STEP_CURVATURE]++;
+        return false;
+    }
+    gpuCount[STEP_CURVATURE]++;
+    return true;
+}
+
+bool particleToGrid(const P2GInput &in, float *field, unsigned char *valid) {
+    State &s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    probe(s);
+    if (!s.available || !ensureContext(s)) {
+        fallbackCount[STEP_ADVECTION]++;
+        return false;
+    }
+
+    size_t numFaces = (size_t)in.isize * (size_t)in.jsize * (size_t)in.ksize;
+    size_t numBlocks = (size_t)in.nbi * (size_t)in.nbj * (size_t)in.nbk;
+    size_t vecBytes = (size_t)in.numParticles * 3 * sizeof(float);
+    s.cu.cuCtxPushCurrent(s.context);
+    const char *step = "";
+    CUresult r = CUDA_SUCCESS;
+    do {
+        step = "GPU memory";
+        if ((r = reserve(s, s.p2gPoints, vecBytes + sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gVelocities, vecBytes + sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.blockActive, numBlocks + 1)) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gSums, numFaces * 2 * sizeof(double))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gField, numFaces * sizeof(float))) != CUDA_SUCCESS) break;
+        if ((r = reserve(s, s.p2gValid, numFaces)) != CUDA_SUCCESS) break;
+
+        step = "Copying to the GPU";
+        if (in.numParticles > 0) {
+            if ((r = s.cu.cuMemcpyHtoD(s.p2gPoints.ptr, in.points, vecBytes)) != CUDA_SUCCESS) break;
+            if ((r = s.cu.cuMemcpyHtoD(s.p2gVelocities.ptr, in.velocities, vecBytes)) != CUDA_SUCCESS) break;
+        }
+        if ((r = s.cu.cuMemcpyHtoD(s.blockActive.ptr, in.blockActive, numBlocks)) != CUDA_SUCCESS) break;
+        // 0.0 in double is all zero bits
+        if ((r = s.cu.cuMemsetD32(s.p2gSums.ptr, 0u, numFaces * 4)) != CUDA_SUCCESS) break;
+
+        int component = in.component, numParticles = in.numParticles;
+        float ox = in.offset[0], oy = in.offset[1], oz = in.offset[2];
+        int nbi = in.nbi, nbj = in.nbj, nbk = in.nbk;
+        int isize = in.isize, jsize = in.jsize, ksize = in.ksize;
+        int blockwidth = in.blockwidth;
+        double dx = in.dx, invDx = 1.0 / in.dx;
+        float blockdxFloat = in.blockdxFloat;
+        double invBlockdxFloat = 1.0 / (double)in.blockdxFloat;
+        double blockdxDouble = in.blockdxDouble;
+        // _advectionFLIPProducerThread's constants, in float as there
+        float rr = in.radius;
+        float sr = in.searchRadius;
+        float rsq = rr * rr;
+        float coef1 = (4.0f / 9.0f) * (1.0f / (rr*rr*rr*rr*rr*rr));
+        float coef2 = (17.0f / 9.0f) * (1.0f / (rr*rr*rr*rr));
+        float coef3 = (22.0f / 9.0f) * (1.0f / (rr*rr));
+        unsigned int threads = 128;
+        if (numParticles > 0) {
+            step = "Velocity transfer kernel";
+            void *args[] = {&s.p2gPoints.ptr, &s.p2gVelocities.ptr, &component, &numParticles,
+                            &ox, &oy, &oz, &s.blockActive.ptr, &nbi, &nbj, &nbk,
+                            &s.p2gSums.ptr, &isize, &jsize, &ksize,
+                            &blockwidth, &dx, &invDx, &blockdxFloat, &invBlockdxFloat, &blockdxDouble,
+                            &rr, &sr, &rsq, &coef1, &coef2, &coef3};
+            unsigned int groups = (unsigned int)((numParticles + threads - 1) / threads);
+            if ((r = s.cu.cuLaunchKernel(s.p2gScatter, groups, 1, 1, threads, 1, 1,
+                                         0, nullptr, args, nullptr)) != CUDA_SUCCESS) break;
+        }
+        int faces = (int)numFaces;
+        float eps = in.eps;
+        void *finishArgs[] = {&s.p2gSums.ptr, &faces, &eps, &s.p2gField.ptr, &s.p2gValid.ptr};
+        unsigned int groups = (unsigned int)((faces + threads - 1) / threads);
+        if ((r = s.cu.cuLaunchKernel(s.p2gFinish, groups, 1, 1, threads, 1, 1,
+                                     0, nullptr, finishArgs, nullptr)) != CUDA_SUCCESS) break;
+        if ((r = s.cu.cuCtxSynchronize()) != CUDA_SUCCESS) break;
+
+        step = "Copying from the GPU";
+        if ((r = s.cu.cuMemcpyDtoH(field, s.p2gField.ptr, numFaces * sizeof(float))) != CUDA_SUCCESS) break;
+        r = s.cu.cuMemcpyDtoH(valid, s.p2gValid.ptr, numFaces);
+    } while (false);
+
+    CUcontext previous;
+    s.cu.cuCtxPopCurrent(&previous);
+
+    if (r != CUDA_SUCCESS) {
+        s.status = errorText(s, r, step);
+        releaseLocked(s);
+        fallbackCount[STEP_ADVECTION]++;
+        return false;
+    }
+    gpuCount[STEP_ADVECTION]++;
+    return true;
+}
