+// Material properties of water/air at ~20 degrees
+static const double HK_RHO_WATER = 998.0;     // kg/m^3
+static const double HK_RHO_AIR   = 1.2;       // kg/m^3
+static const double HK_SIGMA     = 0.0728;    // N/m
+static const double HK_MU_WATER  = 1.0e-3;    // Pa s
+
+static const double HK_MU_AIR = 1.81e-5;     // Pa s, air at ~20 degrees
+
+void DiffuseParticleSimulation::setSprayDropletModel(double d50, double dmin, double dmax) {
+    _buildDiameterTable(_sprayDiameters, d50, dmin, dmax);
+}
+
+void DiffuseParticleSimulation::setDustDropletModel(double d50, double dmin, double dmax) {
