+void ParticleMesher::_applyInteriorCells(ScalarFieldData &fieldData) {
+    // HydroKit: adaptive particle sizes. Nodes inside simulation cells covered
+    // by merged particles count as inside (field > 0 is inside here), as if a
+    // standard particle sat on them. Merged particles stay several cells
+    // below the free surface, so the surface itself comes from particles.
+    if (_interiorCells == nullptr) {
+        return;
+    }
+
+    Array3d<float> *fieldValues = fieldData.fieldValues.getPointerToScalarField();
+    vmath::vec3 offset = fieldData.computeChunk.positionOffset;
+    float insideValue = _interiorValue;
+    for (int k = 0; k < fieldValues->depth; k++) {
+        for (int j = 0; j < fieldValues->height; j++) {
+            for (int i = 0; i < fieldValues->width; i++) {
+                vmath::vec3 p = offset + Grid3d::GridIndexToPosition(i, j, k, _subdx);
+                GridIndex g = Grid3d::positionToGridIndex(p, _dx);
+                if (!_interiorCells->isIndexInRange(g) || !_interiorCells->get(g)) {
+                    continue;
+                }
+                if (fieldValues->get(i, j, k) < insideValue) {
+                    fieldValues->set(i, j, k, insideValue);
+                }
+            }
+        }
+    }
+}
