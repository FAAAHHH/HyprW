 void ParticleMesher::_computeScalarField(ScalarFieldData &fieldData) {
+    // HydroKit: the GPU computes the same field bit for bit (hkgpu_kernels.cu);
+    // whenever it cannot, the CPU does
+    if (_isAnisotropic) {
+        _computeScalarFieldAniso(fieldData);
+        _applyInteriorCells(fieldData);
