+
+/*
+    TriangleMesh::smooth on the GPU: Laplacian smoothing, the same positions
+    bit for bit. Per vertex the CPU walks its triangles in ascending order
+    (_updateVertexTriangles, a triangle twice if it holds the vertex twice)
+    and adds the other corners in tri[0], tri[1], tri[2] order. The lists are
+    built the same way here: counted, filled in any order, then each sorted.
+    The step divides as vmath's operator/= does: inv = 1.0 / count in double,
+    stored as float, then multiplied.
+*/
+extern "C" __global__ void hk_smooth_count(const int *triangles, int nt, int *counts) {
+    size_t t = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (t >= (size_t)nt) {
+        return;
+    }
+    atomicAdd(&counts[triangles[3 * t]], 1);
+    atomicAdd(&counts[triangles[3 * t + 1]], 1);
+    atomicAdd(&counts[triangles[3 * t + 2]], 1);
+}
+
+extern "C" __global__ void hk_smooth_fill(const int *triangles, int nt, const int *offsets,
+                                          int *cursor, int *lists) {
+    size_t t = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (t >= (size_t)nt) {
+        return;
+    }
+    for (int c = 0; c < 3; c++) {
+        int v = triangles[3 * t + c];
+        int slot = offsets[v] + atomicAdd(&cursor[v], 1);
+        lists[slot] = (int)t;
+    }
+}
+
+extern "C" __global__ void hk_smooth_sort(const int *offsets, const int *counts, int nv, int *lists) {
+    size_t v = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (v >= (size_t)nv) {
+        return;
+    }
+    int *l = lists + offsets[v];
+    int n = counts[v];
+    for (int a = 1; a < n; a++) {
+        int x = l[a];
+        int b = a - 1;
+        while (b >= 0 && l[b] > x) {
+            l[b + 1] = l[b];
+            b--;
+        }
+        l[b + 1] = x;
+    }
+}
+
+extern "C" __global__ void hk_smooth_step(const float *in, float *out, int nv, const int *triangles,
+                                          const int *offsets, const int *counts, const int *lists,
+                                          float value) {
+    size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= (size_t)nv) {
+        return;
+    }
+    float ax = 0.0f, ay = 0.0f, az = 0.0f;
+    int count = 0;
+    const int *l = lists + offsets[i];
+    int n = counts[i];
+    for (int m = 0; m < n; m++) {
+        const int *t = triangles + 3 * (size_t)l[m];
+        for (int c = 0; c < 3; c++) {
+            if (t[c] != (int)i) {
+                ax += in[3 * (size_t)t[c]];
+                ay += in[3 * (size_t)t[c] + 1];
+                az += in[3 * (size_t)t[c] + 2];
+                count++;
+            }
+        }
+    }
+    float vx = in[3 * i], vy = in[3 * i + 1], vz = in[3 * i + 2];
+    if (count == 0) {
+        // The CPU computes 0 * inf here: the x86 default NaN in every component
+        float nan = __int_as_float(0xffc00000);
+        out[3 * i] = nan;
+        out[3 * i + 1] = nan;
+        out[3 * i + 2] = nan;
+        return;
+    }
+    float inv = (float)(1.0 / (double)(float)count);
+    ax *= inv;
+    ay *= inv;
+    az *= inv;
+    out[3 * i] = vx + (ax - vx) * value;
+    out[3 * i + 1] = vy + (ay - vy) * value;
+    out[3 * i + 2] = vz + (az - vz) * value;
+}
