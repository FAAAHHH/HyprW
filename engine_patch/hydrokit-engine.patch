+void FluidSimulation::_applySurfaceWindForce(ValidVelocityComponentGrid &ex, double dt) {
+    // Wind only pushes water that is in contact with air. The distance to the
+    // surface is in the particle level set: negative means inside the water, and
+    // the closer to zero, the closer to the surface.
+    //
+    // The force is a drag against the moving air, just like for
+    // whitewater — only much weaker, because a water surface is more sluggish
+    // than a flying drop:
+    //
+    //     dv = factor * (wind - v) * dt
+    //
+    // So the wind can never make the water faster than itself.
+    float eps = 1e-6f;
+    if (_surfaceWindFactor < eps) {
+        return;
+    }
+    float tiefe = (float)(_surfaceWindDepth * _dx);
+    vmath::vec3 w = _surfaceWindVelocity;
+    float f = (float)_surfaceWindFactor;
+    float wlen = vmath::length(w);
+    if (wlen < eps) {
+        return;
+    }
+    // ONLY IN WIND DIRECTION. A first version applied (wind - v) on all three
+    // axes. Because wind has no Z component, that slowed down the FALL of a
+    // jet — at 5 m/s fall speed by far the larger term.
+    // Measured: weak wind shifted the jet by -7 cm, i.e. AGAINST the
+    // wind. Now each axis is only weighted by its share of the wind direction;
+    // across the wind and vertically nothing acts.
+    vmath::vec3 wn = w / wlen;
+    float ax = fabs(wn.x), ay = fabs(wn.y), az = fabs(wn.z);
+
+    for (int k = 0; k < _ksize; k++) {
+        for (int j = 0; j < _jsize; j++) {
+            for (int i = 0; i < _isize; i++) {
+                float phi = _liquidSDF(i, j, k);
+                if (phi > 0.0f || phi < -tiefe) {
+                    continue;        // no air next to it or too deep
+                }
+                // full near the surface, fading out with depth
+                float anteil = 1.0f - (-phi / tiefe);
+                float staerke = f * anteil * (float)dt;
+                if (ax > eps && !ex.validU(i, j, k)) {
+                    _MACVelocity.addU(i, j, k, (w.x - _MACVelocity.U(i, j, k)) * staerke * ax);
+                }
+                if (ay > eps && !ex.validV(i, j, k)) {
+                    _MACVelocity.addV(i, j, k, (w.y - _MACVelocity.V(i, j, k)) * staerke * ay);
+                }
+                if (az > eps && !ex.validW(i, j, k)) {
+                    _MACVelocity.addW(i, j, k, (w.z - _MACVelocity.W(i, j, k)) * staerke * az);
+                }
+            }
+        }
+    }
+}
